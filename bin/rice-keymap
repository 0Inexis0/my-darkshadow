#!/usr/bin/env python3
"""rice-keymap: your own keys for the shell's actions (Settings > System > Keybinds, the pencil).
The keys are kept in ~/.config/rice/keys.conf; Hyprland gets them from ~/.config/hypr/rice-keymap.lua, niri from
the config rice-niri writes (it moves the action to your key).

  rice-keymap list                 JSON: every action, its default and its keys now, and every key Hyprland has
  rice-keymap set ID "SUPER + T"   give the action other keys (right away)
  rice-keymap reset ID | reset-all back to the default
  rice-keymap sheet                JSON: every key in groups, with the keys you chose (the cheatsheet, SUPER + /)
  rice-keymap show                 open or close the cheatsheet
"""
import json
import os
import re
import shutil
import subprocess
import sys

CONF = os.path.expanduser("~/.config/rice/keys.conf")
# the same defaults as rice-keymap.lua
DEFAULTS = {
    "terminal": "SUPER + Return", "launcher": "SUPER + R", "launcher2": "ALT + Space", "settings": "SUPER + U",
    "wallpaper": "SUPER + W", "quick": "SUPER + A", "cc": "SUPER + N", "gamebar": "SUPER + G",
    "dashboard": "SUPER + ALT + D", "lock": "SUPER + L", "close": "SUPER + Q", "float": "SUPER + SHIFT + V", "clipboard": "SUPER + V",
    "shot": "Print", "shotfull": "SHIFT + Print", "record": "SUPER + SHIFT + R", "widgets": "SUPER + ALT + W",
    "infinite": "SUPER + F", "taskview": "SUPER + TAB", "switcher": "ALT + TAB", "keys": "SUPER + slash", "tools": "SUPER + X",
    "minimize": "SUPER + H", "restore": "SUPER + SHIFT + H", "stack": "SUPER + T", "stack_next": "SUPER + CTRL + right", "stack_prev": "SUPER + CTRL + left", "join_left": "SUPER + CTRL + SHIFT + left", "join_right": "SUPER + CTRL + SHIFT + right",
}
# niri: the same actions, its keys (the launcher is SUPER + D there; Infinite Desktop is Hyprland only)
NIRI_DEFAULTS = dict(DEFAULTS, launcher="SUPER + D")
NIRI_DEFAULTS.pop("infinite")
# niri: no minimizing; stacking is niri's own (Mod+T tabs, Mod+[ ] consume / expel)
for _k in ("minimize", "restore", "stack", "stack_next", "stack_prev", "join_left", "join_right"):
    NIRI_DEFAULTS.pop(_k, None)
# (the Task view and the switcher are the shell's on niri too: SUPER + Tab, ALT + Tab)
MODS = [(64, "SUPER"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT")]


def niri():
    return bool(os.environ.get("NIRI_SOCKET"))


def defaults():
    return NIRI_DEFAULTS if niri() else DEFAULTS
KEY_RX = re.compile(r"^((SUPER|CTRL|ALT|SHIFT) \+ ){0,4}[A-Za-z0-9_]{1,24}$")


# ---------------- the cheatsheet (SUPER + /): every key, in groups. [keys, what it does, action id or ""] ----------------
COMMON_TAIL = [
    ("Screenshots and recording", "screenshot_monitor", [
        ["Print", "Screenshot tool: region, window, screen, text, translate, color", "shot"],
        ["Shift + Print", "Screenshot of the whole screen", "shotfull"],
        ["Super + Shift + S", "Screenshot tool", ""],
        ["Super + Shift + R", "Record menu (again: stop)", "record"]]),
    ("Sound, brightness, music", "volume_up", [
        ["Volume keys", "Louder, quieter, mute", ""], ["Super + F12 / F11 / F10", "Louder / quieter / mute", ""],
        ["Alt + ]  /  [", "Louder / quieter", ""], ["Brightness keys", "Screen brighter / darker", ""],
        ["Play / Next / Previous", "Music", ""]]),
]
APPS = [
    ["Super + Return", "Terminal", "terminal"], ["Super + R", "Launcher: find and open apps", "launcher"],
    ["Alt + Space", "Launcher", "launcher2"], ["Super + E", "Files", ""], ["Super + U", "Settings", "settings"],
    ["Super + W", "Wallpapers", "wallpaper"], ["Super + A", "Quick switches", "quick"],
    ["Super + N", "Control center and notifications", "cc"], ["Super + G", "Game bar", "gamebar"],
    ["Super + Alt + D", "Dashboard", "dashboard"], ["Super + L", "Lock the screen", "lock"],
    ["Super + V", "Clipboard: everything you copied", "clipboard"], ["Super + X", "Toolbox: tasks, note, timer, converter, system, chat", "tools"], ["Super + /", "These keys", "keys"]]
SHEET_HYPR = [
    ("Apps and menus", "apps", APPS),
    ("Windows", "select_window", [
        ["Super + Q", "Close the window", "close"], ["Super + Shift + V", "Float / tile the window", "float"],
        ["Super + J", "Split the other way", ""], ["Super + P", "Pseudo-tile (keep its own size)", ""],
        ["Super + F", "Infinite Desktop (Ctrl + wheel zooms)", "infinite"], ["Super + Arrows", "Focus the window next to it", ""],
        ["Super + H", "Minimize the window", "minimize"], ["Super + Shift + H", "Bring back the last minimized window", "restore"],
        ["Super + T", "Stack windows (tabs), or leave the stack", "stack"], ["Super + Ctrl + Left / Right", "Previous / next window of the stack", ""],
        ["Super + Ctrl + Shift + Left / Right", "Put the window into the stack next to it", ""],
        ["Super + Left mouse", "Drag to move the window", ""], ["Super + Right mouse", "Drag to resize the window", ""]]),
    ("Workspaces", "view_carousel", [
        ["Super + Tab", "Task view: every workspace and its windows", "taskview"],
        ["Alt + Tab", "Switch windows", "switcher"], ["Super + 1 … 0", "Go to workspace 1 … 10", ""],
        ["Super + Shift + 1 … 0", "Move the window to a workspace", ""],
        ["Super + Mouse wheel", "Next / previous workspace", ""], ["Super + S", "The hidden scratch workspace", ""]]),
] + COMMON_TAIL + [
    ("Desktop", "desktop_windows", [["Super + Alt + W", "Edit the desktop widgets", "widgets"], ["Super + M", "Log out", ""]]),
]
SHEET_NIRI = [
    ("Apps and menus", "apps", [[("Super + D" if k[2] == "launcher" else k[0]), k[1], k[2]] for k in APPS]),
    ("Windows", "select_window", [
        ["Super + Q", "Close the window", "close"], ["Super + Shift + V", "Float / tile the window", "float"],
        ["Super + F", "Make the column as wide as the screen", ""], ["Super + Shift + F", "Fullscreen", ""],
        ["Super + T", "Windows of a column as tabs", ""], ["Super + R", "Next column width", ""],
        ["Super + Minus / Equal", "Column narrower / wider", ""], ["Super + Arrows", "Focus the window next to it", ""],
        ["Super + Ctrl + Arrows", "Move the window", ""], ["Super + Home / End", "First / last column", ""]]),
    ("Workspaces", "view_carousel", [
        ["Super + Tab", "Task view: every workspace and its windows", "taskview"],
        ["Alt + Tab", "Switch windows", "switcher"], ["Super + 1 … 0", "Go to workspace 1 … 10", ""],
        ["Super + Shift + 1 … 0", "Move the window to a workspace", ""],
        ["Super + Page Up / Down", "Workspace above / below", ""], ["Super + O", "niri's own overview", ""]]),
] + COMMON_TAIL + [
    ("Desktop", "desktop_windows", [["Super + Alt + W", "Edit the desktop widgets", "widgets"],
                                    ["Super + Shift + P", "Screens off", ""], ["Super + Shift + E", "Log out", ""]]),
]
NICE = {"SUPER": "Super", "CTRL": "Ctrl", "ALT": "Alt", "SHIFT": "Shift", "slash": "/", "TAB": "Tab", "RETURN": "Return"}


def pretty(keys):
    """'SUPER + SHIFT + r' -> 'Super + Shift + R' (how the cheatsheet writes keys)"""
    out = []
    for p in (x.strip() for x in keys.split("+")):
        out.append(NICE.get(p) or NICE.get(p.upper()) or (p.upper() if len(p) == 1 else p))
    return " + ".join(out)


def sheet(d):
    groups = []
    for name, sym, keys in (SHEET_NIRI if niri() else SHEET_HYPR):
        rows = []
        for k, what, aid in keys:
            if aid and aid not in defaults():
                continue
            rows.append({"keys": pretty(d[aid]) if aid in d else k, "what": what, "yours": aid in d})
        groups.append({"name": name, "sym": sym, "keys": rows})
    return {"niri": niri(), "groups": groups}


def read():
    out = {}
    try:
        for line in open(CONF):
            m = re.match(r"^\s*([\w]+)\s*=\s*(.*?)\s*$", line)
            if m and m.group(1) in DEFAULTS and m.group(2):
                out[m.group(1)] = m.group(2)
    except OSError:
        pass
    return out


def write(d):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        f.write("# Settings > System > Keybinds: your keys for the shell's actions (id=KEYS)\n")
        for k in sorted(d):
            f.write("%s=%s\n" % (k, d[k]))


def norm(keys):
    """'SUPER + SHIFT + r' -> 'SHIFT+SUPER+R': the same keys always give the same text"""
    parts = [p.strip() for p in keys.split("+") if p.strip()]
    if not parts:
        return ""
    mods = sorted(p.upper() for p in parts[:-1])
    return "+".join(mods + [parts[-1].upper()])


def hypr():
    return bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")) and shutil.which("hyprctl")


def apply():
    if hypr():
        subprocess.run(["hyprctl", "eval", "if RiceKeys then RiceKeys.apply() end"], capture_output=True, timeout=5)
    elif niri():
        # niri reads its config again by itself when the file changes
        subprocess.run([os.path.expanduser("~/.local/bin/rice-niri"), "apply"], capture_output=True, timeout=20)


def niri_binds():
    """the keys niri has now (from the config), for "this key is taken" """
    out = []
    try:
        txt = open(os.path.expanduser("~/.config/niri/config.kdl")).read()
    except OSError:
        return out
    m = re.search(r"^binds\s*\{(.*?)^\}", txt, re.S | re.M)
    for line in (m.group(1) if m else "").splitlines():
        b = re.match(r"^\s*([A-Za-z0-9_+]+)\b[^{]*\{\s*(.*?)\s*\}\s*$", line)
        if not b or "Wheel" in b.group(1):
            continue
        names = {"mod": "SUPER", "super": "SUPER", "ctrl": "CTRL", "alt": "ALT", "shift": "SHIFT"}
        parts = b.group(1).split("+")
        keys = [names.get(p.lower(), p) for p in parts[:-1]] + [parts[-1]]
        out.append({"keys": norm(" + ".join(keys)), "what": b.group(2)[:80]})
    return out


def binds():
    if not hypr():
        return []
    try:
        data = json.loads(subprocess.run(["hyprctl", "-j", "binds"], capture_output=True, text=True, timeout=5).stdout)
    except Exception:
        return []
    out = []
    for b in data:
        mm = int(b.get("modmask", 0) or 0)
        mods = [n for bit, n in MODS if mm & bit]
        key = b.get("key", "")
        if not key or b.get("mouse") or key.startswith("mouse"):
            continue
        what = (b.get("description") or b.get("arg") or b.get("dispatcher") or "").strip()
        out.append({"keys": norm(" + ".join(mods + [key])), "what": what[:80]})
    return out


def main():
    a = sys.argv[1:]
    if not a:
        print(__doc__)
        return
    d = read()
    if a[0] == "list":
        print(json.dumps({"hypr": bool(hypr()), "niri": niri(),
                          "loaded": niri() or os.path.exists(os.path.expanduser("~/.config/hypr/rice-keymap.lua")),
                          "keys": {k: {"default": v, "now": d.get(k, v)} for k, v in defaults().items()},
                          "binds": niri_binds() if niri() else binds()}))
    elif a[0] == "sheet":
        print(json.dumps(sheet(d)))
    elif a[0] == "show":
        import time
        os.makedirs(os.path.expanduser("~/.cache/rice"), exist_ok=True)
        with open(os.path.expanduser("~/.cache/rice/keys-open"), "w") as f:
            f.write("%.3f toggle\n" % time.time())
    elif a[0] == "set" and len(a) == 3 and a[1] in defaults():
        keys = " + ".join(p.strip() for p in a[2].split("+") if p.strip())
        if not KEY_RX.match(keys):
            sys.exit("not keys: " + a[2])
        if norm(keys) == norm(defaults()[a[1]]):
            d.pop(a[1], None)
        else:
            d[a[1]] = keys
        write(d)
        apply()
    elif a[0] == "reset" and len(a) == 2:
        d.pop(a[1], None)
        write(d)
        apply()
    elif a[0] == "reset-all":
        write({})
        apply()
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
