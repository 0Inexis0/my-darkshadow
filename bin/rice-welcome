#!/usr/bin/env bash
# Welcome window shown once per Hyprland session. rice-welcome start|show|on|off|status
dir="$HOME/.config/quickshell/rice-welcome"
off="$HOME/.config/rice/welcome-off"
marker="${XDG_RUNTIME_DIR:-/tmp}/rice-welcome-${HYPRLAND_INSTANCE_SIGNATURE:-session}"
running() { pgrep -f "quickshell/rice-welcome" >/dev/null; }
launch() {
  [ -f "$dir/shell.qml" ] || { echo "missing $dir/shell.qml" >&2; exit 1; }
  running && exit 0
  command -v qs >/dev/null 2>&1 || { echo "qs not found" >&2; exit 1; }
  setsid -f qs -n -p "$dir" >/dev/null 2>&1
}
case "$1" in
  start)
    [ -f "$off" ] && exit 0
    [ -e "$marker" ] && exit 0
    : >"$marker"
    sleep 2
    launch
    ;;
  show) launch ;;
  on)  rm -f "$off"; echo "welcome: on" ;;
  off) mkdir -p "$(dirname "$off")"; : >"$off"; echo "welcome: off" ;;
  status) [ -f "$off" ] && echo off || echo on ;;
  *) echo "usage: rice-welcome start|show|on|off|status" >&2; exit 1 ;;
esac
