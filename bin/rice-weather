#!/usr/bin/env bash
# The weather for the widgets and the lock screen: "condition|temperature|place" (wttr.in).
# °C or °F follows Settings > Language & region (rice-region).
# rice-weather json: more for the Forecast widget (now, feels like, high / low, rain, the next hours), as one JSON
# line, kept for 30 minutes in ~/.cache/rice/weather.json
#
# Privacy: wttr.in answers for the caller's IP when the URL has no place, so the shell does not ask at all until a
# place is set. That keeps your approximate location out of a third party's log.
#   rice-weather place "Warsaw"     (or any place name wttr.in knows)
#   rice-weather off                (no requests; the last cached answer is still shown)
#   rice-weather state              {"place": "..."} (Settings > Language & region > Online lookups)
CFG="$HOME/.config/rice/weather.json"

weather_place() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("place",""))' "$CFG" 2>/dev/null; }
save_place() {
  mkdir -p "$(dirname "$CFG")"
  python3 -c 'import json,os,sys; p=sys.argv[1]; t=p+".tmp"; json.dump({"place": sys.argv[2].strip()}, open(t,"w")); os.replace(t,p)' "$CFG" "$1"
}

# An install from before V4.48 already showed the weather: wttr.in had named its place (the third field of the
# cached answer). That place is kept, so the weather goes on without asking where the IP is again.
if [ ! -e "$CFG" ] && [ -s "$HOME/.cache/rice/weather.txt" ]; then
  old="$(cut -d'|' -s -f3 "$HOME/.cache/rice/weather.txt" | head -1 | tr -d '\r')"
  case "$old" in ""|*"<"*|*Unknown*) ;; *) save_place "$old" ;; esac
fi

case "${1:-}" in
  state)
    python3 -c 'import json,sys
try: p = json.load(open(sys.argv[1])).get("place", "")
except Exception: p = ""
print(json.dumps({"place": p}))' "$CFG" ;;
  place)
    [ -n "${2:-}" ] || { echo "rice-weather place \"Warsaw\"" >&2; exit 2; }
    save_place "$2" && echo "Weather for: $2" ;;
  off)
    save_place "" && echo "Weather requests: off (the cached answer is still shown)" ;;
  *)
    loc="$(weather_place)"
    unit="m"
    grep -q '"units": *"f"' "$HOME/.config/rice/region.json" 2>/dev/null && unit="u"
    url_place=""
    [ -n "$loc" ] && url_place="$(python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))' "$loc")"
    if [ "${1:-}" = json ]; then
      f="$HOME/.cache/rice/weather.json"
      mkdir -p "$HOME/.cache/rice"
      if [ -s "$f" ] && [ -n "$(find "$f" -mmin -30 2>/dev/null)" ]; then cat "$f"; exit 0; fi
      # no place: no request, only what was already cached
      [ -n "$url_place" ] || { [ -s "$f" ] && cat "$f"; exit 1; }
      raw="$(curl -s -m 12 "wttr.in/$url_place?format=j1&lang=en")" || { [ -s "$f" ] && cat "$f"; exit 1; }
      j="$(printf '%s' "$raw" | python3 -c '
import json, sys, datetime
f = sys.argv[1] == "u"
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
def t(o, k):
    return int(float(o.get(k + ("F" if f else "C"), 0)))
c = d["current_condition"][0]
area = (d.get("nearest_area") or [{}])[0]
place = ((area.get("areaName") or [{}])[0].get("value", ""))
country = ((area.get("country") or [{}])[0].get("value", ""))
days = d.get("weather") or []
now = datetime.datetime.now()
hours = []
for di, day in enumerate(days[:2]):
    for h in day.get("hourly", []):
        hh = int(h.get("time", "0")) // 100
        at = datetime.datetime.strptime(day["date"], "%Y-%m-%d").replace(hour=hh)
        if at <= now:
            continue
        hours.append({"h": hh, "t": t(h, "temp"), "c": (h.get("weatherDesc") or [{}])[0].get("value", "").strip(),
                      "rain": int(h.get("chanceofrain", 0))})
out = {"temp": t(c, "temp_"), "feels": t(c, "FeelsLike"), "cond": (c.get("weatherDesc") or [{}])[0].get("value", "").strip(),
       "hum": int(c.get("humidity", 0)), "wind": int(c.get("windspeedMiles" if f else "windspeedKmph", 0)),
       "unit": "F" if f else "C", "place": place, "country": country,
       "hi": t(days[0], "maxtemp") if days else 0, "lo": t(days[0], "mintemp") if days else 0,
       "hours": hours[:5],
       "days": [{"d": x["date"], "hi": t(x, "maxtemp"), "lo": t(x, "mintemp"),
                 "c": ((x.get("hourly") or [{}]*5)[4].get("weatherDesc") or [{}])[0].get("value", "").strip()} for x in days[:3]]}
print(json.dumps(out))
' "$unit")" || { [ -s "$f" ] && cat "$f"; exit 1; }
      printf '%s\n' "$j" > "$f"
      printf '%s\n' "$j"
      exit 0
    fi
    [ -n "$url_place" ] || { [ -s "$HOME/.cache/rice/weather.txt" ] && cat "$HOME/.cache/rice/weather.txt"; exit 1; }
    out="$(curl -s -m 10 "wttr.in/$url_place?format=%C|%t|%l&${unit}&lang=en")" || exit 1
    case "$out" in ""|*Unknown*|*"<"*) exit 1 ;; esac
    [ "$(printf '%s' "$out" | tr -cd '|' | wc -c | tr -d ' ')" = 2 ] || exit 1
    mkdir -p "$HOME/.cache/rice"
    printf '%s\n' "$out" > "$HOME/.cache/rice/weather.txt"
    printf '%s\n' "$out" ;;
esac
