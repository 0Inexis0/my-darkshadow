#!/usr/bin/env python3
# prints one JSON line every 2 seconds (or every N seconds: rice-stats N):
# (also: up = seconds since start, load, rx / tx = bytes a second, freq GHz, fan rpm, bat %, charging, cores)
# {"cpu":N,"ram":N,"gpu":N,"temp":C,"gtemp":C,"ramu":GB,"ramt":GB,"swap":N,"swapu":GB,"swapt":GB,"disk":N,"disku":GB,"diskt":GB}
# cpu/ram/gpu in %, temp = CPU temperature, gtemp = GPU temperature (0 when unknown)
import glob
import json
import shutil
import subprocess
import sys
import time


def cpu_times():
    f = open("/proc/stat").readline().split()[1:]
    v = [int(x) for x in f]
    return v[3] + v[4], sum(v)


def ram():
    m = {}
    for ln in open("/proc/meminfo"):
        k, v = ln.split(":")[0], ln.split(":")[1].split()[0]
        m[k] = int(v)
    t = m.get("MemTotal", 1)
    used = t - m.get("MemAvailable", 0)
    return round(100 * used / t), round(used / 1048576, 1), round(t / 1048576, 1)


def swap():
    m = {}
    for ln in open("/proc/meminfo"):
        k, v = ln.split(":")[0], ln.split(":")[1].split()[0]
        m[k] = int(v)
    t = m.get("SwapTotal", 0)
    used = t - m.get("SwapFree", 0)
    return (round(100 * used / t) if t else 0), round(used / 1048576, 1), round(t / 1048576, 1)


def disk():
    try:
        d = shutil.disk_usage("/")
        return round(100 * d.used / d.total), round(d.used / 1e9), round(d.total / 1e9)
    except OSError:
        return 0, 0, 0


def read(p):
    try:
        return open(p).read().strip()
    except Exception:
        return ""


def hwmon(names):
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        if read(d + "/name") in names:
            for f in ("temp1_input", "temp2_input"):
                v = read(d + "/" + f)
                if v.isdigit():
                    return round(int(v) / 1000)
    return 0


CPU_LABELS = ("tctl", "tdie", "package id 0", "cpu", "cpu temperature", "cputin", "core 0", "tccd1")


def cpu_temp():
    t = hwmon(("k10temp", "coretemp", "zenpower", "zenpower3", "k8temp", "fam15h_power", "via_cputemp", "cpu_thermal"))
    if t:
        return t
    # a sensor that names the processor on one of its lines (boards with their own chip: asus-ec, nct67xx, it87 ...)
    for f in sorted(glob.glob("/sys/class/hwmon/hwmon*/temp*_label")):
        if read(f).lower() in CPU_LABELS:
            v = read(f.replace("_label", "_input"))
            if v.isdigit() and 0 < int(v) < 130000:
                return round(int(v) / 1000)
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        if read(z + "/type") in ("x86_pkg_temp", "cpu-thermal", "TCPU", "acpitz", "soc_thermal", "cpu_thermal"):
            v = read(z + "/temp")
            if v.isdigit() and int(v) > 0:
                return round(int(v) / 1000)
    return hwmon(("acpitz", "thinkpad"))


def fan():
    """the fastest fan that turns, in turns a minute (0 when the board does not tell)"""
    best = 0
    for f in glob.glob("/sys/class/hwmon/hwmon*/fan*_input"):
        v = read(f)
        if v.isdigit():
            best = max(best, int(v))
    return best


def battery():
    """(percent, charging) of the first battery, or (-1, False)"""
    for d in sorted(glob.glob("/sys/class/power_supply/BAT*")):
        v = read(d + "/capacity")
        if v.isdigit():
            return int(v), read(d + "/status") in ("Charging", "Full")
    return -1, False


def net_bytes():
    rx = tx = 0
    try:
        for ln in open("/proc/net/dev").readlines()[2:]:
            name, rest = ln.split(":", 1)
            if name.strip() == "lo":
                continue
            f = rest.split()
            rx += int(f[0])
            tx += int(f[8])
    except Exception:
        pass
    return rx, tx


def uptime():
    try:
        return int(float(open("/proc/uptime").read().split()[0]))
    except Exception:
        return 0


def load1():
    try:
        return round(float(open("/proc/loadavg").read().split()[0]), 2)
    except Exception:
        return 0


def freq():
    """how fast the cores run right now, in GHz (their average)"""
    v = [int(read(f)) for f in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq") if read(f).isdigit()]
    return round(sum(v) / len(v) / 1e6, 1) if v else 0


NV = shutil.which("nvidia-smi")
DRM = [p for p in glob.glob("/sys/class/drm/card*/device/gpu_busy_percent")]


def gpu():
    """(busy %, temperature) of the first GPU that tells: NVIDIA via nvidia-smi, AMD / Intel via sysfs"""
    if NV:
        try:
            o = subprocess.run([NV, "--query-gpu=utilization.gpu,temperature.gpu", "--format=csv,noheader,nounits"],
                               capture_output=True, text=True, timeout=3).stdout.strip().split("\n")[0].split(",")
            return int(float(o[0])), int(float(o[1]))
        except Exception:
            pass
    for p in DRM:
        v = read(p)
        if v.isdigit():
            return int(v), hwmon(("amdgpu", "i915", "xe"))
    return 0, hwmon(("amdgpu", "nouveau", "i915", "xe"))


every = 2.0
if len(sys.argv) > 1:
    try:
        every = max(0.5, min(10.0, float(sys.argv[1])))
    except ValueError:
        pass
import os
CORES = os.cpu_count() or 1
rx0, tx0 = net_bytes()
t0 = time.time()
idle0, tot0 = cpu_times()
# V4.95: nvidia-smi is a heavy program (and wakes the card): with NVIDIA it is asked every third time only
tick, g, gt = 0, 0, 0
while True:
    time.sleep(every)
    idle1, tot1 = cpu_times()
    dt = tot1 - tot0
    c = round(100 * (1 - (idle1 - idle0) / dt)) if dt > 0 else 0
    idle0, tot0 = idle1, tot1
    r, ru, rt = ram()
    if not NV or tick % 3 == 0:
        g, gt = gpu()
    tick += 1
    s, su, stt = swap()
    dk, du, dt2 = disk()
    rx1, tx1 = net_bytes()
    t1 = time.time()
    span = max(0.2, t1 - t0)
    rx, tx = max(0, int((rx1 - rx0) / span)), max(0, int((tx1 - tx0) / span))
    rx0, tx0, t0 = rx1, tx1, t1
    bat, chg = battery()
    sys.stdout.write(json.dumps({"cpu": max(0, min(100, c)), "ram": r, "gpu": max(0, min(100, g)),
                                 "temp": cpu_temp(), "gtemp": gt, "ramu": ru, "ramt": rt,
                                 "swap": s, "swapu": su, "swapt": stt, "disk": dk, "disku": du, "diskt": dt2,
                                 "up": uptime(), "load": load1(), "rx": rx, "tx": tx, "freq": freq(), "fan": fan(),
                                 "bat": bat, "charging": chg, "cores": CORES}) + "\n")
    sys.stdout.flush()
