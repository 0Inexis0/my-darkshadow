#!/usr/bin/env python3
# prints one JSON line every 2 seconds: {"cpu":N,"ram":N,"gpu":N}
import json
import shutil
import subprocess
import sys
import time


def cpu_times():
    f = open("/proc/stat").readline().split()[1:]
    v = [int(x) for x in f]
    return v[3] + v[4], sum(v)


def ram():
    m = {}
    for ln in open("/proc/meminfo"):
        k, v = ln.split(":")[0], ln.split(":")[1].split()[0]
        m[k] = int(v)
    t = m.get("MemTotal", 1)
    return round(100 * (t - m.get("MemAvailable", 0)) / t)


def gpu():
    if not shutil.which("nvidia-smi"):
        return 0
    try:
        o = subprocess.run(["nvidia-smi", "--query-gpu=utilization.gpu", "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=3).stdout.strip().split("\n")[0]
        return int(float(o))
    except Exception:
        return 0


idle0, tot0 = cpu_times()
while True:
    time.sleep(2)
    idle1, tot1 = cpu_times()
    dt = tot1 - tot0
    c = round(100 * (1 - (idle1 - idle0) / dt)) if dt > 0 else 0
    idle0, tot0 = idle1, tot1
    sys.stdout.write(json.dumps({"cpu": max(0, min(100, c)), "ram": ram(), "gpu": max(0, min(100, gpu()))}) + "\n")
    sys.stdout.flush()
