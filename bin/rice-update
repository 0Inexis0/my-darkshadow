#!/usr/bin/env python3
"""rice-update: updates for DarkShadow's Shell.

  rice-update               install the newest version (runs ./install.sh --update in the repo)
  rice-update check [--json] [--offline]
                            compare your version with the newest one on GitHub
  rice-update watch [on|off|state]  background: checks after login and once a day, shows a notification; off: no checks
                            (how often: every_minutes in ~/.config/rice/update.json, 60 - 10080)
  rice-update notify        show the "Update is Available!" notification now (to try it)
  rice-update gui           update in the background for Settings > Update Center (no terminal): the steps go to
                            ~/.cache/rice/update-live.log, the state to ~/.cache/rice/update-live.json
"""
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
INSTALLED = DIR + "/version"
CACHE = HOME + "/.cache/rice"
STATE = CACHE + "/update.json"
NOTIFIED = CACHE + "/update-notified"
LIVE_LOG = CACHE + "/update-live.log"
LIVE = CACHE + "/update-live.json"
RAW = "https://raw.githubusercontent.com/0Inexis0/my-darkshadow/main/VERSION"
FIRST_WAIT = 45            # seconds after login
UPDATE_CFG = DIR + "/update.json"
DEFAULTS = {"watch": True, "every_minutes": 1440}   # one ask a day: enough for updates, a smaller trail at GitHub
TICK = 30                  # a check from the About tab of the dashboard is noticed within this many seconds
APP = "DarkShadow's Shell"
ICON = HOME + "/.local/share/rice/icon.png"


def cfg():
    """background checks: on by default (a security fix has to reach people), once a day, and the user decides"""
    c = dict(DEFAULTS)
    try:
        raw = json.load(open(UPDATE_CFG))
        if isinstance(raw, dict):
            c.update({k: raw[k] for k in DEFAULTS if k in raw})
        c["every_minutes"] = max(60, min(10080, int(c["every_minutes"])))
    except Exception:
        pass
    return c


def save_cfg(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = UPDATE_CFG + ".tmp"
    json.dump(c, open(tmp, "w"))
    os.replace(tmp, UPDATE_CFG)


def repo():
    try:
        r = open(DIR + "/repo").read().strip()
        if r and os.path.exists(r + "/install.sh"):
            return r
    except OSError:
        pass
    r = HOME + "/my-darkshadow"
    return r if os.path.exists(r + "/install.sh") else None


def key(v):
    """'2.02' < '2.1' == '2.10' < '3.0' (the part after the dot reads like decimals)"""
    try:
        major, _, minor = v.strip().lstrip("vV").partition(".")
        return (int(major), float("0." + (minor or "0")))
    except ValueError:
        return (0, 0.0)


def clean(v):
    v = (v or "").strip().lstrip("vV")
    return v if v and key(v) > (0, 0.0) else ""


def installed():
    try:
        return clean(open(INSTALLED).read()) or "2.01"
    except OSError:
        return "2.01"   # installs from before versions existed


def git(r, *a, timeout=25):
    # never a login window: no prompt, and no credential helper (a helper like Git Credential Manager opened a GitHub
    # sign-in window during updates; the shell is public, reading it needs no login)
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="true", SSH_ASKPASS="true", GCM_INTERACTIVE="never")
    return subprocess.run(["git", "-c", "credential.helper=", "-C", r] + list(a), capture_output=True, text=True,
                          timeout=timeout, env=env)


NEW_URL = "https://github.com/0Inexis0/my-darkshadow.git"


def news(text, version):
    """first lines of the CHANGELOG entry for this version"""
    out, on = [], False
    for ln in (text or "").splitlines():
        h = ln.strip()
        if h.startswith("## "):
            if on:
                break
            on = h[3:].strip().lstrip("vV").startswith(version)
            continue
        if on and h.startswith(("- ", "* ")):
            out.append(h[2:].strip())
    return out


def latest(offline=False):
    """Newest version: the fork main, else its raw file, else your repo.
    Also: how many new commits GitHub has that this computer does not (an update without a new number)."""
    r = repo()
    found, err = [], ""
    latest.ahead, latest.sha, latest.log = 0, "", ""
    if r and os.path.isdir(r + "/.git") and shutil.which("git"):
        try:
            if not offline:
                f = git(r, "fetch", "--quiet", "--no-tags", NEW_URL, "main")
                if f.returncode != 0:
                    err = (f.stderr.strip().splitlines() or ["git fetch failed"])[-1]
            refs = ["origin/main"] if offline else (["FETCH_HEAD"] if f.returncode == 0 else [])
            for ref in refs:
                s = git(r, "show", ref + ":VERSION", timeout=5)
                if s.returncode == 0 and clean(s.stdout):
                    found.append(clean(s.stdout))
                    a = git(r, "rev-list", "--count", "HEAD.." + ref, timeout=5)
                    latest.ahead = int(a.stdout.strip() or 0) if a.returncode == 0 else 0
                    h = git(r, "rev-parse", "--short", ref, timeout=5)
                    latest.sha = h.stdout.strip() if h.returncode == 0 else ""
                    cl = git(r, "show", ref + ":CHANGELOG.md", timeout=5)
                    latest.log = cl.stdout if cl.returncode == 0 else ""
                    break
        except Exception as e:
            err = str(e)
    if not found and not offline and shutil.which("curl"):
        try:
            c = subprocess.run(["curl", "-fsSL", "--max-time", "15", RAW], capture_output=True, text=True, timeout=20)
            if c.returncode == 0 and clean(c.stdout):
                found.append(clean(c.stdout))
                err = ""
        except Exception as e:
            err = err or str(e)
    if r:
        try:
            found.append(clean(open(r + "/VERSION").read()))   # pulled but not installed yet
        except OSError:
            pass
        if not latest.log:
            try:
                latest.log = open(r + "/CHANGELOG.md").read()
            except OSError:
                pass
    found = [v for v in found if v]
    return (max(found, key=key) if found else ""), err


def managed():
    return os.path.exists(DIR + "/managed-by-nixos")


def managed_latest(offline=False):
    """Compare exact commits from the fork's main; never fetch into the installed store source."""
    try:
        have = Path(DIR, "fork-revision").read_text().strip()
    except OSError:
        have = "unknown"
    sha, error = have, ""
    if not offline:
        try:
            result = git(HOME, "ls-remote", NEW_URL, "refs/heads/main")
            candidate = result.stdout.split()[0] if result.returncode == 0 and result.stdout.split() else ""
            if not re.fullmatch(r"[0-9a-f]{40}", candidate):
                raise RuntimeError(result.stderr.strip() or "Could not read fork main")
            sha = candidate
        except Exception as exc:
            error = str(exc)
    return {"installed": installed(), "latest": installed(), "update": sha != have,
            "changes": int(sha != have), "commit": sha[:12], "installedCommit": have[:12],
            "news": ["my-darkshadow main: " + sha[:12]] if sha != have else [],
            "checked": int(time.time()), "error": error, "managed": True,
            "source": "0Inexis0/my-darkshadow · main"}


def check(offline=False):
    have = installed()
    new, err = (have, "") if managed() else latest(offline)
    newer = bool(new) and key(new) > key(have)
    ahead = getattr(latest, "ahead", 0)
    out = {"installed": have, "latest": new or have, "update": newer or ahead > 0,
           "changes": ahead, "commit": getattr(latest, "sha", ""),
           "news": news(getattr(latest, "log", ""), new or have)[:4],
           "checked": int(time.time()), "error": err if not new else ""}
    if managed():
        out = managed_latest(offline)
    os.makedirs(CACHE, exist_ok=True)
    try:
        with open(STATE, "w") as stream:
            json.dump(out, stream)
    except OSError:
        pass
    return out


def terminal_update():
    t = os.environ.get("TERMINAL") or "kitty"
    if not shutil.which(t):
        t = next((x for x in ("kitty", "foot", "alacritty", "wezterm", "konsole", "gnome-terminal") if shutil.which(x)), t)
    cmd = [t, "-e", HOME + "/.local/bin/rice-update"]
    if os.access(HOME + "/.local/bin/rice-term", os.X_OK):        # your terminal (Settings > Look & Feel)
        cmd = [HOME + "/.local/bin/rice-term", "-e", HOME + "/.local/bin/rice-update"]
    subprocess.Popen(cmd, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def open_center():
    """Settings > Update Center (the update runs there, with its steps shown live); a terminal without Settings"""
    rs = HOME + "/.local/bin/rice-settings"
    if os.access(rs, os.X_OK):
        subprocess.Popen([rs, "35"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        terminal_update()


def live():
    try:
        return json.load(open(LIVE))
    except (OSError, ValueError):
        return {}


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def put_live(**kw):
    os.makedirs(CACHE, exist_ok=True)
    tmp = LIVE + ".new"
    with open(tmp, "w") as f:
        json.dump(kw, f)
    os.replace(tmp, LIVE)


def gui(args):
    """the update without a terminal: install.sh --update --yes --no-packages, detached from Settings (the update
    puts new Settings files in place, so Settings reloads in the middle; this keeps running and Settings reads on)"""
    st = live()
    if st.get("state") == "running" and alive(st.get("pid")):
        print("already updating")
        return 0
    r = repo()
    os.makedirs(CACHE, exist_ok=True)
    if not r:
        open(LIVE_LOG, "w").write("    \u2718 Could not find your copy of the repo (~/my-darkshadow). Clone it again:\n"
                                  "      git clone https://github.com/0Inexis0/my-darkshadow ~/my-darkshadow\n")
        put_live(state="failed", code=1, started=int(time.time()), ended=int(time.time()), pid=0)
        return 1
    if os.fork() != 0:
        return 0
    os.setsid()
    if os.fork() != 0:
        os._exit(0)
    log = open(LIVE_LOG, "w", buffering=1)
    t0 = int(time.time())
    put_live(state="running", code=-1, started=t0, ended=0, pid=os.getpid(), was=installed())
    env = dict(os.environ, RICE_GUI="1", NO_COLOR="1", GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never")
    env.pop("SUDO_ASKPASS", None)
    want = ["--update", "--yes"] + (args if args else ["--no-packages"])
    try:
        code = subprocess.call(["./install.sh"] + want, cwd=r, env=env, stdin=subprocess.DEVNULL,
                               stdout=log, stderr=subprocess.STDOUT)
    except Exception as e:
        log.write("    \u2718 %s\n" % e)
        code = 1
    try:
        check(offline=True)
    except Exception:
        pass
    put_live(state="done" if code == 0 else "failed", code=code, started=t0, ended=int(time.time()), pid=0,
             was=live().get("was", ""), now=installed())
    os._exit(0)


def body(st):
    v = st["latest"]
    head = "<b>Update V%s</b>" % v
    if st.get("installed") and st["installed"] != v:
        head += "  ·  you have V%s" % st["installed"]
    elif st.get("changes"):
        head += "  ·  %d new change%s" % (st["changes"], "" if st["changes"] == 1 else "s")
    lines = [head]
    for n in (st.get("news") or [])[:3]:
        lines.append("•  " + n.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))
    return "\n".join(lines)


def notify(st):
    """the popup; clicking it (or Update now) opens the update in a terminal"""
    if not shutil.which("notify-send"):
        return
    icon = ICON if os.path.exists(ICON) else "system-software-update"
    try:
        r = subprocess.run(["notify-send", "-a", APP, "-i", icon, "-u", "normal", "-t", "20000",
                            "-c", "system.update",
                            "-A", "default=Update now", "-A", "update=Update now", "-A", "later=Later",
                            "--wait", "Update is Available!", body(st)],
                           capture_output=True, text=True, timeout=6 * 3600)
        if r.stdout.strip() in ("default", "update"):
            open_center()
    except Exception:
        pass


def notify_bg(st):
    if os.fork() == 0:
        os.setsid()
        notify(st)
        os._exit(0)


def maybe_notify(st):
    """show the popup once per new version / new push"""
    if not st or not st.get("update"):
        return
    try:
        told = open(NOTIFIED).read().strip()
    except OSError:
        told = ""
    tag = "%s %s" % (st.get("latest", ""), st.get("commit", ""))
    if told != tag:
        open(NOTIFIED, "w").write(tag)
        notify_bg(st)


def mtime(p):
    try:
        return os.path.getmtime(p)
    except OSError:
        return 0


def watch():
    c = cfg()
    if c.get("watch") is False:
        return
    every = int(c["every_minutes"]) * 60
    os.makedirs(CACHE, exist_ok=True)
    lk = open(CACHE + "/update-watch.lock", "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # already running
    time.sleep(FIRST_WAIT)
    last, seen = 0.0, 0.0
    while True:
        # Settings > Language & region > Check for updates is read again every tick: off stops this one at once
        c = cfg()
        if c.get("watch") is False:
            return
        every = int(c["every_minutes"]) * 60
        try:
            if time.time() - last >= every:
                last = time.time()
                st = check()
                seen = mtime(STATE)
                maybe_notify(st)
            else:
                # the About tab of the dashboard (or rice-update check) found something: tell right away
                m = mtime(STATE)
                if m and m != seen:
                    seen = m
                    maybe_notify(json.load(open(STATE)))
        except Exception:
            pass
        time.sleep(TICK)


def run(args):
    r = repo()
    if not r:
        print("Could not find your copy of the repo. Clone it again:")
        print("  git clone https://github.com/0Inexis0/my-darkshadow ~/my-darkshadow")
        input("Press Enter to close")
        sys.exit(1)
    os.chdir(r)
    code = subprocess.call(["./install.sh", "--update"] + args)
    print()
    try:
        input("Press Enter to close")
    except EOFError:
        pass
    sys.exit(code)


def managed_checkout():
    """Use a dedicated user checkout, preserving any local modifications or diverged history."""
    target = os.path.join(HOME, ".local/share/my-darkshadow/update-source")
    if not os.path.exists(target):
        os.makedirs(os.path.dirname(target), exist_ok=True)
        result = git(HOME, "clone", "--single-branch", "--branch", "main", NEW_URL, target, timeout=120)
        if result.returncode:
            raise RuntimeError(result.stderr.strip())
    if not os.path.isdir(target + "/.git"):
        raise RuntimeError("Update folder is not a Git checkout: " + target)
    status = git(target, "status", "--porcelain", timeout=10)
    if status.returncode:
        raise RuntimeError(status.stderr.strip() or "Could not inspect update checkout")
    if status.stdout.strip():
        raise RuntimeError("Local edits in " + target + "; commit or move them before updating.")
    branch = git(target, "branch", "--show-current").stdout.strip()
    if branch != "main":
        raise RuntimeError("Update checkout must be on main; leaving it unchanged.")
    for args in [("fetch", "--no-tags", NEW_URL, "main"), ("merge", "--ff-only", "FETCH_HEAD")]:
        result = git(target, *args, timeout=120)
        if result.returncode:
            raise RuntimeError(result.stderr.strip() or result.stdout.strip())
    return target


def managed_run():
    os.makedirs(CACHE, exist_ok=True)
    lock = open(CACHE + "/system-update.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("An update is already running.")
        return 1
    started = int(time.time())
    put_live(state="running", code=-1, started=started, pid=os.getpid())
    code = 1
    target_revision = ""
    with open(LIVE_LOG, "w", buffering=1) as log:
        def report(message):
            print(message, flush=True)
            log.write(message + "\n")
        try:
            report("▶ Fetch 0Inexis0/my-darkshadow · main")
            checkout = managed_checkout()
            target_revision = git(checkout, "rev-parse", "--short=12", "HEAD").stdout.strip()
            report("✔ Fetch 0Inexis0/my-darkshadow · main")
            try:
                profile = Path(DIR, "personal-profile").read_text().strip()
            except OSError:
                profile = "generic"
            if profile not in ("generic", "legion"):
                raise RuntimeError("Unknown installed hardware profile")
            report("▶ Build NixOS boot generation — enter your password in this terminal")
            code = subprocess.call(["bash", "personal/bootstrap.sh", "--system", "--yes", "--profile", profile], cwd=checkout)
            if code == 0:
                report("✔ Build NixOS boot generation — reboot to activate the update")
            else:
                report("✘ NixOS build failed; see the terminal output")
        except Exception as exc:
            report("✘ " + str(exc))
    put_live(state="done" if code == 0 else "failed", code=code, started=started,
             ended=int(time.time()), pid=0, reboot=code == 0, commit=target_revision)
    try:
        input("Press Enter to close")
    except EOFError:
        pass
    return code


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    if managed() and cmd not in ("check", "watch", "notify", "center", "-h", "--help", "help"):
        if cmd == "gui":
            terminal_update()
            return 0
        return managed_run()
    if cmd == "check":
        st = check(offline="--offline" in a)
        if "--json" in a:
            print(json.dumps(st))
        elif st["update"]:
            extra = (" (%d new changes)" % st["changes"]) if st["latest"] == st["installed"] and st["changes"] else ""
            print("Update V%s is available%s (you have V%s). Run: rice-update" % (st["latest"], extra, st["installed"]))
            for n in st["news"]:
                print("  - " + n)
        else:
            print("Up to date: V%s%s" % (st["installed"], ("  (could not check: %s)" % st["error"]) if st["error"] else ""))
    elif cmd == "watch":
        if len(a) > 2 and a[2] == "state":
            c = cfg()
            print(json.dumps({"watch": c.get("watch") is not False, "every_minutes": c["every_minutes"]}))
        elif len(a) > 2 and a[2] in ("on", "off"):
            c = cfg()
            c["watch"] = a[2] == "on"
            save_cfg(c)
            print("Background update checks: " + ("on" if c["watch"] else "off"))
            if c["watch"]:
                subprocess.Popen([sys.executable, os.path.abspath(__file__), "watch"], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, start_new_session=True)
        else:
            watch()
    elif cmd == "notify":
        st = check(offline="--offline" in a)
        if not st["news"]:
            st["news"] = ["This is how the update notification looks"]
        notify_bg(st)
    elif cmd == "gui":
        sys.exit(gui(a[2:]))
    elif cmd == "center":
        open_center()
    elif cmd in ("", "run"):
        run(a[2:])
    elif cmd in ("-h", "--help", "help"):
        print(__doc__)
    else:
        run(a[1:])   # pass flags like --no-packages on to install.sh


if __name__ == "__main__":
    sys.exit(main(sys.argv) or 0)
