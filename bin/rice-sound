#!/usr/bin/env python3
"""rice-sound: how the volume you set turns into loudness (Settings > Sound & language > Sound > Volume).

  rice-sound state                 JSON: {curve, max}
  rice-sound set curve gentle|natural   gentle (default): the low part of the slider is louder, so 20 % is still
                                   easy to hear; natural: the curve other apps use (below about 35 % it is very quiet)
  rice-sound set max 100|125|150   how loud the top of the slider is (above 100: louder than the system's own 100 %,
                                   can distort on some speakers)
  rice-sound step +5|-5            the volume keys: 5 points of the slider up or down (unmutes on the way up)
  rice-sound get                   the slider's value now, 0 .. 100

The slider value d (0 .. 1) gives the loudness  max^3 * d^p,  p = 3 for natural, 1.8 for gentle. PipeWire's own
volume (wpctl, Quickshell) is the cube root of the loudness, so  v = max * d^(p/3).
"""
import json
import os
import re
import subprocess
import sys

CONF = os.path.expanduser("~/.config/rice/sound.json")
P = {"gentle": 1.8, "natural": 3.0}


def load():
    c = {"curve": "gentle", "max": 100}
    try:
        j = json.load(open(CONF))
        if j.get("curve") in P:
            c["curve"] = j["curve"]
        if int(j.get("max", 100)) in (100, 125, 150):
            c["max"] = int(j["max"])
    except Exception:
        pass
    return c


def to_v(d, c):
    d = max(0.0, min(1.0, d))
    return c["max"] / 100.0 * d ** (P[c["curve"]] / 3.0)


def to_d(v, c):
    m = c["max"] / 100.0
    return max(0.0, min(1.0, (max(0.0, v) / m) ** (3.0 / P[c["curve"]])))


def wp(*a):
    try:
        return subprocess.run(["wpctl", *a], capture_output=True, text=True, timeout=4).stdout
    except Exception:
        return ""


def now():
    m = re.search(r"Volume:\s*([0-9.]+)", wp("get-volume", "@DEFAULT_AUDIO_SINK@"))
    return float(m.group(1)) if m else 0.0


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    c = load()
    if cmd == "state":
        print(json.dumps(c))
    elif cmd == "set" and len(a) == 4:
        if a[2] == "curve" and a[3] in P:
            c["curve"] = a[3]
        elif a[2] == "max" and a[3] in ("100", "125", "150"):
            c["max"] = int(a[3])
        else:
            sys.exit(__doc__)
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        json.dump(c, open(CONF, "w"))
    elif cmd == "get":
        print(round(to_d(now(), c) * 100))
    elif cmd == "step" and len(a) == 3 and re.match(r"^[+-]\d{1,2}$", a[2]):
        st = int(a[2]) / 100.0
        d = round((to_d(now(), c) + st) * 100) / 100
        if st > 0:
            wp("set-mute", "@DEFAULT_AUDIO_SINK@", "0")
        wp("set-volume", "-l", "%.2f" % (c["max"] / 100.0), "@DEFAULT_AUDIO_SINK@", "%.4f" % to_v(d, c))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
