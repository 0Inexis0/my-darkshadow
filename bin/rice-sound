#!/usr/bin/env python3
"""rice-sound: the sound of the shell.

Notification sounds (Settings > Notifications > Sound):
  rice-sound list                  sounds you can pick
  rice-sound play [NAME [VOL]]     play NAME (or the chosen one) now, e.g. to preview it
  rice-sound notify                called for every new notification (swaync, and the shell's own notifications)

How the volume you set turns into loudness (Settings > Sound & language > Sound > Volume):
  rice-sound state                 JSON: {curve, max}
  rice-sound set curve gentle|natural   gentle (default): the low part of the slider is louder, so 20 % is still
                                   easy to hear; natural: the curve other apps use (below about 35 % it is very quiet)
  rice-sound set max 100|125|150   how loud the top of the slider is (above 100: louder than the system's own 100 %,
                                   can distort on some speakers)
  rice-sound step +5|-5            the volume keys: 5 points of the slider up or down (unmutes on the way up)
  rice-sound get                   the slider's value now, 0 .. 100

The slider value d (0 .. 1) gives the loudness  max^3 * d^p,  p = 3 for natural, 1.8 for gentle. PipeWire's own
volume (wpctl, Quickshell) is the cube root of the loudness, so  v = max * d^(p/3).

(V5.01: V4.84 put the volume curve in this file in place of the notification sounds, so no notification made a
sound and the preview in Settings was silent; both live here now)
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CFG = HOME + "/.config/rice/notify.json"
DIRS = [HOME + "/.local/share/rice/sounds", "/run/current-system/sw/share/rice/sounds"]
SOUNDS = ["glass", "droplet", "chime", "bubble", "marimba", "aurora", "ping", "harp", "keys", "ripple"]
STAMP = HOME + "/.cache/rice/sound.last"
# never ding for these: volume/brightness popups and the like
QUIET_APPS = {"rice-media", "swayosd", "volume", "brightness", "brightnessctl"}


def conf():
    try:
        c = json.load(open(CFG))
    except Exception:
        c = {}
    name = c.get("sound", "glass")
    vol = c.get("sound_volume", 45)
    try:
        vol = max(0, min(100, int(float(vol))))
    except Exception:
        vol = 45
    return name, vol


def path(name):
    for d in DIRS:
        p = "%s/%s.wav" % (d, name)
        if os.path.exists(p):
            return p
    return None


def play(name, vol):
    p = path(name)
    if not p or vol <= 0:
        return
    # V5.02: the slider follows your ears (a curve, not a straight line): 45 % is a soft ding, 100 % the full sound
    v = (vol / 100.0) ** 1.7
    if shutil.which("pw-play"):
        cmd = ["pw-play", "--media-role", "Notification", "--volume", "%.2f" % v, p]
    elif shutil.which("paplay"):
        cmd = ["paplay", "--volume", str(int(65536 * v)), p]
    elif shutil.which("aplay"):
        cmd = ["aplay", "-q", p]
    elif shutil.which("ffplay"):
        cmd = ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", "-volume", str(int(v * 100)), p]
    else:
        return
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def dnd():
    # the shell shows notifications itself (rice-cc engine shell): its own Do Not Disturb, and no swaync-client
    # call (that would start swaync again through D-Bus)
    try:
        cc = json.load(open(HOME + "/.config/rice/cc.json"))
        if cc.get("engine") == "shell":
            return cc.get("dnd") is True
    except Exception:
        pass
    if not shutil.which("swaync-client"):
        return False
    try:
        r = subprocess.run(["swaync-client", "-D", "-sw"], capture_output=True, text=True, timeout=1.5)
        return r.stdout.strip() == "true"
    except Exception:
        return False


def let_go():
    """close swaync's pipe before anything else (swaync 0.12 crashes if it stays open after we end)"""
    try:
        fd = os.open(os.devnull, os.O_RDWR)
        for n in (0, 1, 2):
            os.dup2(fd, n)
        if fd > 2:
            os.close(fd)
    except OSError:
        pass


def notify():
    let_go()
    # return to swaync at once, decide in the background
    if os.fork() > 0:
        return
    os.setsid()
    name, vol = conf()
    if name not in SOUNDS or vol <= 0:
        return
    app = os.environ.get("SWAYNC_APP_NAME", "").strip().lower()
    if app in QUIET_APPS:
        return
    if os.environ.get("SWAYNC_REPLACES_ID", "0") not in ("", "0"):
        return  # an update of a notification already shown (progress, volume, ...)
    if dnd():
        return
    # one sound for a burst of notifications
    now = time.time()
    try:
        if now - os.path.getmtime(STAMP) < 0.6:
            return
    except OSError:
        pass
    os.makedirs(os.path.dirname(STAMP), exist_ok=True)
    open(STAMP, "w").close()
    play(name, vol)


CONF = os.path.expanduser("~/.config/rice/sound.json")
P = {"gentle": 1.8, "natural": 3.0}


def load():
    c = {"curve": "gentle", "max": 100}
    try:
        j = json.load(open(CONF))
        if j.get("curve") in P:
            c["curve"] = j["curve"]
        if int(j.get("max", 100)) in (100, 125, 150):
            c["max"] = int(j["max"])
    except Exception:
        pass
    return c


def to_v(d, c):
    d = max(0.0, min(1.0, d))
    return c["max"] / 100.0 * d ** (P[c["curve"]] / 3.0)


def to_d(v, c):
    m = c["max"] / 100.0
    return max(0.0, min(1.0, (max(0.0, v) / m) ** (3.0 / P[c["curve"]])))


def wp(*a):
    try:
        return subprocess.run(["wpctl", *a], capture_output=True, text=True, timeout=4).stdout
    except Exception:
        return ""


def now():
    m = re.search(r"Volume:\s*([0-9.]+)", wp("get-volume", "@DEFAULT_AUDIO_SINK@"))
    return float(m.group(1)) if m else 0.0


def notify_main(a):
    cmd = a[1] if len(a) > 1 else ""
    if cmd == "list":
        print(json.dumps([{"name": s, "available": path(s) is not None} for s in SOUNDS]))
    elif cmd == "play":
        name, vol = conf()
        if len(a) > 2:
            name = a[2]
        if len(a) > 3:
            vol = max(0, min(100, int(float(a[3]))))
        play(name, vol)
    elif cmd == "notify":
        notify()
    else:
        return False
    return True


def main(a):
    if notify_main(a):
        return
    cmd = a[1] if len(a) > 1 else ""
    c = load()
    if cmd == "state":
        print(json.dumps(c))
    elif cmd == "set" and len(a) == 4:
        if a[2] == "curve" and a[3] in P:
            c["curve"] = a[3]
        elif a[2] == "max" and a[3] in ("100", "125", "150"):
            c["max"] = int(a[3])
        else:
            sys.exit(__doc__)
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        json.dump(c, open(CONF, "w"))
    elif cmd == "get":
        print(round(to_d(now(), c) * 100))
    elif cmd == "step" and len(a) == 3 and re.match(r"^[+-]\d{1,2}$", a[2]):
        st = int(a[2]) / 100.0
        d = round((to_d(now(), c) + st) * 100) / 100
        if st > 0:
            wp("set-mute", "@DEFAULT_AUDIO_SINK@", "0")
        wp("set-volume", "-l", "%.2f" % (c["max"] / 100.0), "@DEFAULT_AUDIO_SINK@", "%.4f" % to_v(d, c))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
