#!/usr/bin/env bash
exec 9>"$XDG_RUNTIME_DIR/ws-watch.lock"
flock -n 9 || exit 0
sock="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
socat -u "UNIX-CONNECT:$sock" - | while read -r line; do
  case "$line" in
    workspace*|focusedmon*|createworkspace*|destroyworkspace*) pkill -RTMIN+8 waybar ;;
  esac
done
