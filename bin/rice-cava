#!/usr/bin/env bash
cfg="$HOME/.cache/rice/cava-widget.conf"
mkdir -p "$HOME/.cache/rice"
cat > "$cfg" <<CONF
[general]
bars = 64
framerate = 30
[input]
method = pipewire
source = auto
[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
bar_delimiter = 59
frame_delimiter = 10
[smoothing]
noise_reduction = 60
CONF
exec cava -p "$cfg" 2>>"$HOME/.cache/rice/cava-widget.log"
