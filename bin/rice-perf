#!/usr/bin/env python3
"""rice-perf: how much memory and processor the shell's parts use right now, and what would make it lighter.

  rice-perf          a short table (the biggest first) and tips
  rice-perf json     the same as JSON

Memory is PSS (each shared page counted once, split between the programs that share it): the honest number. The
graphics driver's own memory (NVIDIA most of all) is not in it, and on some drivers it shows up in RSS instead.
"""
import json
import os
import sys
import time

MINE = ("quickshell", "qs", "rice-", "hypr-set", "border-sync", "ws-watch", "rice-notifyd", "mpvpaper", "awww",
        "swww", "hypridle", "hyprlock", "cliphist", "wl-paste")


def name_of(pid):
    try:
        cmd = open("/proc/%s/cmdline" % pid, "rb").read().split(b"\0")
    except OSError:
        return None, None
    cmd = [c.decode(errors="replace") for c in cmd if c]
    if not cmd:
        return None, None
    exe = os.path.basename(cmd[0])
    full = " ".join(cmd)
    if exe in ("python3", "python", "bash", "sh") and len(cmd) > 1:
        exe = os.path.basename(cmd[1])
    if "quickshell/rice-desktop" in full:
        return "shell (desktop)", full
    if "quickshell/rice-settings" in full:
        return "Settings", full
    if "quickshell/rice-apps" in full:
        # our Files, Photos or Music / Videos (which one: its environment says)
        try:
            env = open("/proc/%s/environ" % pid, "rb").read().split(b"\0")
            app = next((e[9:].decode() for e in env if e.startswith(b"RICE_APP=")), "files")
        except OSError:
            app = "files"
        return {"files": "Files", "photos": "Photos", "player": "Music / Videos"}.get(app, app) + " (app)", full
    if not any(exe.startswith(m) or exe == m for m in MINE):
        return None, None
    return exe, full


def pss(pid):
    try:
        for line in open("/proc/%s/smaps_rollup" % pid):
            if line.startswith("Pss:"):
                return int(line.split()[1]) * 1024
    except OSError:
        pass
    try:
        return int(open("/proc/%s/statm" % pid).read().split()[1]) * os.sysconf("SC_PAGE_SIZE")
    except OSError:
        return 0


def cpu_ticks(pid):
    try:
        f = open("/proc/%s/stat" % pid).read().rsplit(")", 1)[1].split()
        return int(f[11]) + int(f[12])
    except (OSError, IndexError, ValueError):
        return 0


def main(a):
    procs = {}
    for pid in os.listdir("/proc"):
        if pid.isdigit() and int(pid) != os.getpid():
            n, full = name_of(pid)
            if n:
                procs[pid] = n
    t0 = {p: cpu_ticks(p) for p in procs}
    time.sleep(1.0)
    hz = os.sysconf("SC_CLK_TCK")
    rows = {}
    for p, n in procs.items():
        r = rows.setdefault(n, {"name": n, "mem": 0, "cpu": 0.0, "count": 0})
        r["mem"] += pss(p)
        r["cpu"] += (cpu_ticks(p) - t0.get(p, 0)) / hz * 100
        r["count"] += 1
    out = sorted(rows.values(), key=lambda r: -r["mem"])
    total = sum(r["mem"] for r in out)
    tips = []
    home = os.path.expanduser("~")
    if any(r["name"].startswith("Settings") for r in out) and not os.path.exists(home + "/.config/rice/settings-keep"):
        tips.append("Settings is open or closing; it quits by itself a minute after you close it.")
    if os.path.exists(home + "/.config/rice/settings-keep"):
        tips.append("Settings waits in the background (about 300 MB): Settings > Desktop > Performance > Keep Settings ready: off.")
    if not os.path.exists(home + "/.cache/rice/lite"):
        tips.append("A laptop or an older graphics card: Settings > Desktop > Performance > Light mode (no blur, no shadows).")
    try:
        d = json.load(open(home + "/.config/rice/desktop.json"))
        on = [k for k, v in d.items() if isinstance(v, dict) and v.get("enabled") is True]
        if len(on) > 4:
            tips.append("%d desktop widgets are on (%s): each one you turn off frees its memory." % (len(on), ", ".join(on[:8])))
    except Exception:
        pass
    if any(r["name"] == "mpvpaper" for r in out):
        tips.append("A live wallpaper (mpvpaper) plays a video all the time: a picture wallpaper is much lighter.")
    if a[1:2] == ["json"]:
        print(json.dumps({"rows": out, "total": total, "tips": tips}))
        return
    print("%-26s %10s %8s" % ("", "memory", "cpu"))
    for r in out:
        print("%-26s %8.0f MB %7.1f%%" % (r["name"] + (" x%d" % r["count"] if r["count"] > 1 else ""), r["mem"] / 1048576, r["cpu"]))
    print("%-26s %8.0f MB" % ("all together", total / 1048576))
    if tips:
        print()
        for t in tips:
            print("- " + t)


if __name__ == "__main__":
    main(sys.argv)
