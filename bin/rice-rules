#!/usr/bin/env python3
"""rice-rules: your own window rules and the gaming workspace (Settings > Desktop > Window rules).
They are kept in ~/.config/rice/rules.json, which no update touches. Hyprland gets them from
~/.config/hypr/rice-rules.lua (written here, loaded before user.lua), niri from the config rice-niri writes.

  rice-rules list              JSON: the gaming workspace, your rules, and whether this is niri
  rice-rules save JSON         save everything (the same shape as list) and apply it
  rice-rules windows           JSON: the windows open now (app id and title), to make a rule from one
  rice-rules apply             write the Hyprland file again / rebuild the niri config
  rice-rules watch             keeps "this app opens on that workspace" (started by rice-desktop; one copy runs).
                               Hyprland: a window rule acts only at the moment a window opens, and many apps
                               (Discord, Spotify, games through Proton) get their class a moment later, so the
                               rule missed them. niri: open-on-workspace only knows named workspaces. This
                               watches new windows for a few seconds and moves one that is not where it should be.
"""
import fcntl
import socket
import time
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
CONF = HOME + "/.config/rice/rules.json"
LUA = HOME + "/.config/hypr/rice-rules.lua"
BIN = HOME + "/.local/bin"

# what games look like: Steam games (steam_app_N), gamescope, Proton and Wine (.exe), Minecraft
GAME_RX = r"^(steam_app_[0-9]+|gamescope|steam_proton|.+\.exe|[Mm]inecraft.*)$"
# the launchers, when you want them there too
LAUNCHER_RX = (r"^(steam|[Ss]team|heroic|com\.heroicgameslauncher\.hgl|lutris|net\.lutris\.Lutris|"
               r"com\.usebottles\.bottles|org\.prismlauncher\.PrismLauncher|retroarch|org\.libretro\.RetroArch)$")

DEF_GAMING = {"on": False, "ws": "9", "launchers": True, "fullscreen": False, "nogaps": True, "follow": True}
DEF_RULE = {"on": True, "by": "class", "match": "", "name": "", "float": False, "center": False, "w": 0, "h": 0,
            "ws": "", "silent": False, "opacity": 1.0, "fullscreen": False, "maximize": False, "pin": False}


def niri():
    return bool(os.environ.get("NIRI_SOCKET"))


def clean_ws(v):
    v = str(v or "").strip()
    return v if re.match(r"^[A-Za-z0-9_\-]{1,24}$", v) else ""


def clean_rule(r):
    out = dict(DEF_RULE)
    if isinstance(r, dict):
        for k in DEF_RULE:
            if k in r:
                out[k] = r[k]
    out["by"] = "title" if out["by"] == "title" else "class"
    out["match"] = str(out["match"]).replace("\n", " ").strip()[:200]
    out["name"] = str(out["name"]).replace("\n", " ").strip()[:60]
    for k in ("on", "float", "center", "silent", "fullscreen", "maximize", "pin"):
        out[k] = bool(out[k])
    for k in ("w", "h"):
        try:
            out[k] = max(0, min(8000, int(out[k])))
        except (TypeError, ValueError):
            out[k] = 0
    try:
        out["opacity"] = round(max(0.1, min(1.0, float(out["opacity"]))), 2)
    except (TypeError, ValueError):
        out["opacity"] = 1.0
    out["ws"] = clean_ws(out["ws"])
    return out


def load():
    try:
        j = json.load(open(CONF))
    except Exception:
        j = {}
    g = dict(DEF_GAMING)
    if isinstance(j.get("gaming"), dict):
        g.update({k: j["gaming"][k] for k in DEF_GAMING if k in j["gaming"]})
    g["ws"] = clean_ws(g["ws"]) or "9"
    for k in ("on", "launchers", "fullscreen", "nogaps", "follow"):
        g[k] = bool(g[k])
    rules = [clean_rule(r) for r in j.get("rules", []) if isinstance(r, dict)]
    return {"gaming": g, "rules": [r for r in rules if r["match"]]}


def save(c):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        json.dump(c, f, indent=2)
    os.replace(tmp, CONF)


def valid_rx(s):
    try:
        re.compile(s)
        return True
    except re.error:
        return False


# ---------------- Hyprland ----------------
def lstr(s):
    return '"' + str(s).replace("\\", "\\\\").replace('"', '\\"') + '"'


def hypr_ws(ws):
    # a number is a normal workspace; a word is a named one
    return ws if ws.isdigit() else "name:" + ws


def lua_text(c):
    L = ["-- generated by rice-rules (Settings > Desktop > Window rules). Do not edit: your rules are kept in",
         "-- ~/.config/rice/rules.json and this file is written again from it. Each rule is on its own, so one",
         "-- Hyprland does not know never stops the others.", ""]
    g = c["gaming"]
    if g["on"]:
        ws = hypr_ws(g["ws"])
        L.append("-- the gaming workspace")
        game = {"name": "rice-games-ws", "class": GAME_RX, "ws": ws + ("" if g["follow"] else " silent")}
        L.append("pcall(hl.window_rule, { name = %s, match = { class = %s }, workspace = %s%s })" % (
            lstr(game["name"]), lstr(game["class"]), lstr(game["ws"]), ", fullscreen = true" if g["fullscreen"] else ""))
        if g["launchers"]:
            L.append("pcall(hl.window_rule, { name = \"rice-games-launchers\", match = { class = %s }, workspace = %s })" % (
                lstr(LAUNCHER_RX), lstr(ws + " silent")))
        if g["nogaps"]:
            L.append("pcall(hl.workspace_rule, { workspace = %s, gaps_in = 0, gaps_out = 0 })" % lstr(ws))
        L.append("")
    n = 0
    for r in c["rules"]:
        if not r["on"] or not valid_rx(r["match"]):
            continue
        n += 1
        parts = ["name = %s" % lstr("rice-user-rule-%d" % n),
                 "match = { %s = %s }" % (r["by"], lstr(r["match"]))]
        if r["float"] or r["pin"]:
            parts.append("float = true")
        if r["center"]:
            parts.append("center = true")
        if r["w"] and r["h"]:
            parts.append("size = %s" % lstr("%d %d" % (r["w"], r["h"])))
        if r["ws"]:
            parts.append("workspace = %s" % lstr(hypr_ws(r["ws"]) + (" silent" if r["silent"] else "")))
        if r["opacity"] < 0.999:
            parts.append("opacity = %s" % lstr("%s %s" % (r["opacity"], r["opacity"])))
        if r["fullscreen"]:
            parts.append("fullscreen = true")
        elif r["maximize"]:
            parts.append("maximize = true")
        if r["pin"]:
            parts.append("pin = true")
        L.append("-- " + (r["name"] or r["match"]).replace("\n", " "))
        L.append("pcall(hl.window_rule, { %s })" % ", ".join(parts))
    if not g["on"] and n == 0:
        L.append("-- no rules yet")
    return "\n".join(L) + "\n"


def run(cmd, timeout=20):
    try:
        return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def start_watch():
    """the watcher (it does nothing when there is nothing to watch; only one copy runs)"""
    if os.access(BIN + "/rice-rules", os.X_OK):
        try:
            subprocess.Popen([BIN + "/rice-rules", "watch"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except Exception:
            pass


def apply(c=None):
    c = c or load()
    start_watch()
    if niri():
        if os.access(BIN + "/rice-niri", os.X_OK):
            run([BIN + "/rice-niri", "apply"], timeout=30)
        return
    os.makedirs(os.path.dirname(LUA), exist_ok=True)
    new = lua_text(c)
    old = open(LUA).read() if os.path.exists(LUA) else ""
    if new != old:
        open(LUA, "w").write(new)
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and os.access(BIN + "/rice-wm", os.X_OK):
            run([BIN + "/rice-wm", "reload"])


def windows():
    out = []
    if niri():
        try:
            for w in json.loads(run(["niri", "msg", "-j", "windows"]) or "[]"):
                out.append({"cls": w.get("app_id") or "", "title": w.get("title") or ""})
        except Exception:
            pass
    else:
        try:
            for w in json.loads(run(["hyprctl", "clients", "-j"]) or "[]"):
                if w.get("mapped", True) and (w.get("class") or w.get("title")):
                    out.append({"cls": w.get("class") or "", "title": w.get("title") or ""})
        except Exception:
            pass
    seen, uniq = set(), []
    for w in out:
        k = (w["cls"], w["title"])
        if k not in seen and w["title"] != "Rice Settings":
            seen.add(k)
            uniq.append(w)
    return uniq


# ---------------- watch: new windows go to their workspace ----------------
def target(c, cls, title):
    """(workspace, follow) for a window, or None: your rules first, then the gaming workspace"""
    for r in c["rules"]:
        if not r["on"] or not r["ws"] or not valid_rx(r["match"]):
            continue
        if re.search(r["match"], title if r["by"] == "title" else cls):
            return r["ws"], not r["silent"]
    g = c["gaming"]
    if g["on"]:
        if re.search(GAME_RX, cls):
            return g["ws"], g["follow"]
        if g["launchers"] and re.search(LAUNCHER_RX, cls):
            return g["ws"], False
    return None


def hypr_disp(lua, *legacy):
    out = run(["hyprctl", "dispatch", lua], timeout=4).strip().lower() if lua else ""
    if out.startswith("ok"):
        return True
    if legacy:
        return run(["hyprctl", "dispatch", *legacy], timeout=4).strip().lower().startswith("ok")
    return False


def hypr_move(addr, ws, follow):
    """move one window to a workspace (Lua Hyprland moves the focused window: focus it first)"""
    sel = ws if ws.isdigit() else "name:" + ws
    if hypr_disp('hl.dsp.focus({ window = "address:%s" })' % addr):
        if hypr_disp('hl.dsp.window.move({ workspace = "%s", follow = %s })' % (sel, "true" if follow else "false")):
            return True
    return hypr_disp("", "movetoworkspace" if follow else "movetoworkspacesilent", "%s,address:%s" % (sel, addr))


def hypr_client(addr):
    try:
        for w in json.loads(run(["hyprctl", "-j", "clients"]) or "[]"):
            if w.get("address") == addr:
                return w
    except ValueError:
        pass
    return None


def hypr_check(addr, c, done):
    w = hypr_client(addr)
    if not w:
        return True                       # gone
    t = target(c, w.get("class") or w.get("initialClass") or "", w.get("title") or "")
    if not t:
        return False                      # no class yet, maybe later
    ws, follow = t
    cur = w.get("workspace") or {}
    if (ws.isdigit() and str(cur.get("id")) == ws) or str(cur.get("name")) == ws:
        return True                       # the rule did it
    hypr_move(addr, ws, follow)
    return True


def hypr_sock():
    rt = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    return "%s/hypr/%s/.socket2.sock" % (rt, sig)


def watch_hypr():
    pending = {}                          # address -> time it opened
    while True:
        try:
            sk = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sk.connect(hypr_sock())
            sk.settimeout(0.25)
            buf = b""
            while True:
                try:
                    data = sk.recv(4096)
                    if not data:
                        break
                    buf += data
                    while b"\n" in buf:
                        line, buf = buf.split(b"\n", 1)
                        if line.startswith(b"openwindow>>"):
                            a = line[12:].split(b",", 1)[0].decode(errors="ignore")
                            pending["0x" + a if not a.startswith("0x") else a] = time.time()
                except socket.timeout:
                    pass
                if pending:
                    c = load()
                    if not c["gaming"]["on"] and not any(r["on"] and r["ws"] for r in c["rules"]):
                        pending.clear()
                        continue
                    now = time.time()
                    for a, t0 in list(pending.items()):
                        if now - t0 < 0.35:
                            continue              # give the rule its moment first
                        if hypr_check(a, c, None) or now - t0 > 4:
                            pending.pop(a, None)
        except Exception:
            pass
        time.sleep(2)


def niri_json(what):
    try:
        return json.loads(run(["niri", "msg", "-j", what]) or "null")
    except ValueError:
        return None


def watch_niri():
    seen = {}                             # id -> time it first showed up
    done = set()
    first = True
    while True:
        try:
            p = subprocess.Popen(["niri", "msg", "-j", "event-stream"], stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, text=True)
            for line in p.stdout:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if "WindowsChanged" in ev:
                    # the windows open when it starts (or niri restarted the stream): leave them where they are
                    for w in ev["WindowsChanged"].get("windows", []):
                        done.add(w.get("id"))
                    first = False
                    continue
                w = (ev.get("WindowOpenedOrChanged") or {}).get("window")
                if not w or w.get("id") in done:
                    continue
                wid = w.get("id")
                seen.setdefault(wid, time.time())
                if time.time() - seen[wid] > 4:
                    done.add(wid)
                    continue
                c = load()
                t = target(c, w.get("app_id") or "", w.get("title") or "")
                if not t:
                    continue
                ws, follow = t
                if not ws.isdigit():
                    done.add(wid)                 # a named workspace: niri's own open-on-workspace does it
                    continue
                cur = next((x for x in (niri_json("workspaces") or []) if x.get("id") == w.get("workspace_id")), {})
                done.add(wid)
                if str(cur.get("idx")) == ws:
                    continue
                run(["niri", "msg", "action", "move-window-to-workspace", "--window-id", str(wid),
                     "--focus", "true" if follow else "false", ws])
            p.wait()
        except Exception:
            pass
        time.sleep(2)


def watch():
    os.makedirs(HOME + "/.cache/rice", exist_ok=True)
    lock = open(HOME + "/.cache/rice/rules-watch.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0                          # one copy runs already
    if niri():
        watch_niri()
    elif os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        watch_hypr()
    return 0


def main(a):
    cmd = a[0] if a else "list"
    if cmd == "list":
        c = load()
        c["niri"] = niri()
        c["game_rx"] = GAME_RX
        print(json.dumps(c))
    elif cmd == "save" and len(a) > 1:
        try:
            j = json.loads(a[1])
        except ValueError:
            print("not JSON", file=sys.stderr)
            return 1
        cur = load()
        if isinstance(j.get("gaming"), dict):
            cur["gaming"].update({k: j["gaming"][k] for k in DEF_GAMING if k in j["gaming"]})
        if isinstance(j.get("rules"), list):
            cur["rules"] = j["rules"]
        save(cur)
        apply(load())
    elif cmd == "windows":
        print(json.dumps(windows()))
    elif cmd == "apply":
        apply()
    elif cmd == "watch":
        return watch()
    elif cmd == "lua":
        sys.stdout.write(lua_text(load()))
    else:
        print(__doc__.strip())
        return 0 if cmd in ("-h", "--help", "help") else 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
