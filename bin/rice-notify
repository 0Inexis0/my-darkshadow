#!/usr/bin/env python3
"""rice-notify: notification popups and the notification center (swaync). Settings > Notifications.

  rice-notify state | set KEY VALUE | apply | reset | restore | test | panel
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CFG = DIR + "/notify.json"
FONTS = DIR + "/fonts.json"
SW = HOME + "/.config/swaync"
SWCFG = SW + "/config.json"
SWCSS = SW + "/style.css"
HYPR = HOME + "/.config/hypr"
LUA = HYPR + "/rice-notify.lua"
HLUA = HYPR + "/hyprland.lua"
WAYBAR_COLORS = HOME + "/.config/waybar/colors.css"
BEGIN, END = "/* rice-notify */", "/* end-rice-notify */"

DEFAULTS = {
    "pos_x": "right", "pos_y": "top", "margin": 10,
    "layout": "deck", "panel_width": 440, "panel_height": 820, "fit": True,
    "w_buttons": True, "w_media": True, "w_volume": True, "w_dnd": True, "w_title": True,
    # the Deck notification center: side, floating or against the edge, and its rows
    "cc_side": "right", "cc_float": True, "w_quick": True, "w_power": True, "w_brightness": True, "w_session": True,
    "popup_width": 360, "timeout": 6, "critical_sticky": True, "icon_size": 40, "images": True,
    "style": "glass", "popup_style": "match", "opacity": 0.80, "radius": 18, "blur": True, "compact": False, "accent": True,
    "colors": "graphite", "font": "sans", "font_size": 13, "popup_opacity": 0.85, "blur_popups": True,
    "border": "subtle", "shadow": False,
    "sound": "glass", "sound_volume": 70,
}
INTS = {"margin": (0, 60), "panel_width": (300, 700), "panel_height": (300, 1400), "popup_width": (260, 600),
        "timeout": (2, 30), "icon_size": (20, 72), "radius": (0, 32), "font_size": (10, 18),
        "sound_volume": (0, 100)}
FLOATS = {"opacity": (0.3, 1.0), "popup_opacity": (0.3, 1.0)}
CHOICES = {"pos_x": ["left", "center", "right"], "pos_y": ["top", "bottom"],
           "layout": ["deck", "controls-top", "controls-bottom", "minimal"], "style": ["glass", "solid", "outline"],
           "cc_side": ["left", "right"],
           "popup_style": ["match", "glass", "solid", "minimal", "pill", "accent", "glow", "island", "light"],
           "colors": ["black", "graphite", "slate", "white", "tinted"], "font": ["sans", "rounded", "mono", "system"],
           "border": ["subtle", "accent", "none"],
           "sound": ["glass", "droplet", "chime", "bubble", "marimba", "aurora", "off"]}
ORDER = {
    # Deck: switches on top, power modes, notifications, media, volume and brightness, power buttons at the bottom
    "deck": ["buttons-grid#quick", "buttons-grid#power", "title", "notifications", "mpris", "volume", "backlight",
             "buttons-grid#session"],
    "controls-top": ["buttons-grid", "mpris", "volume", "dnd", "title", "notifications"],
    "controls-bottom": ["title", "dnd", "notifications", "mpris", "volume", "buttons-grid"],
    "minimal": ["title", "dnd", "notifications"],
}
WKEY = {"buttons-grid": "w_buttons", "mpris": "w_media", "volume": "w_volume", "dnd": "w_dnd", "title": "w_title",
        "buttons-grid#quick": "w_quick", "buttons-grid#power": "w_power", "backlight": "w_brightness",
        "buttons-grid#session": "w_session"}
SVC = HOME + "/.local/bin/rice-services"


def die(m):
    sys.stderr.write(m + "\n")
    sys.exit(1)


def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def load():
    c = dict(DEFAULTS)
    try:
        raw = json.load(open(CFG))
    except Exception:
        raw = {}
    for k, d in DEFAULTS.items():
        v = raw.get(k, d)
        if isinstance(d, bool):
            c[k] = v is True
        elif k in CHOICES:
            c[k] = v if v in CHOICES[k] else d
        elif k in FLOATS:
            try:
                c[k] = round(clamp(float(v), *FLOATS[k]), 2)
            except Exception:
                c[k] = d
        else:
            try:
                c[k] = int(clamp(float(v), *INTS[k]))
            except Exception:
                c[k] = d
    # V2.50: the new Deck notification center replaces the old layouts once
    if raw.get("v", 1) < 2:
        c["layout"] = "deck"
        c["w_volume"] = True
    # V2.51: the Deck needs the room: full screen height (a gap all around when floating), a bit wider
    if raw.get("v", 1) < 3:
        c["fit"] = True
        c["panel_width"] = max(c["panel_width"], 440)
    c["v"] = 3
    return c


def save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = CFG + ".tmp"
    json.dump(c, open(tmp, "w"))
    os.replace(tmp, CFG)


def accent():
    try:
        s = open(WAYBAR_COLORS).read()
        a = re.search(r"@define-color\s+accent\s+#([0-9a-fA-F]{6})", s)
        o = re.search(r"@define-color\s+on_accent\s+#([0-9a-fA-F]{6})", s)
        return "#" + (a.group(1) if a else "d4d4d4"), "#" + (o.group(1) if o else "0d0d0d")
    except Exception:
        return "#d4d4d4", "#0d0d0d"


FONT_STACKS = {
    "sans": '"Inter", "Inter Variable", "Rubik", "Noto Sans", "Cantarell", "Symbols Nerd Font", "JetBrainsMono Nerd Font", sans-serif',
    "rounded": '"Rubik", "Nunito", "Quicksand", "Inter", "Noto Sans", "Symbols Nerd Font", "JetBrainsMono Nerd Font", sans-serif',
    "mono": '"JetBrainsMono Nerd Font", "JetBrains Mono", monospace',
}


def font(c):
    if c["font"] in FONT_STACKS:
        return FONT_STACKS[c["font"]]
    try:
        f = json.load(open(FONTS))
        return '"%s", "Symbols Nerd Font", sans-serif' % (f.get("main") or "Noto Sans").replace('"', "")
    except Exception:
        return "sans-serif"


def palette(c, acc):
    """base surface rgb, text, secondary text, card overlay"""
    k = c["colors"]
    if k == "black":
        return (0, 0, 0), "#F6F5F4", "#9a9aa4", "rgba(255, 255, 255, 0.07)"
    if k == "slate":
        return (24, 27, 34), "#EEF1F6", "#9aa4b5", "rgba(255, 255, 255, 0.06)"
    if k == "white":
        return (246, 245, 244), "#141414", "#5c5c64", "rgba(0, 0, 0, 0.05)"
    if k == "tinted":
        h = acc.lstrip("#")
        try:
            a = tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
        except Exception:
            a = (212, 212, 212)
        return tuple(int(14 + (x - 14) * 0.14) for x in a), "#F6F5F4", "#a8a8b4", "rgba(255, 255, 255, 0.07)"
    return (18, 18, 20), "#F6F5F4", "#9a9aa4", "rgba(255, 255, 255, 0.06)"


def backup_once(path, suf):
    if os.path.exists(path) and not os.path.exists(path + suf):
        shutil.copy2(path, path + suf)


# ---------------- config.json ----------------
def write_config(c):
    try:
        j = json.load(open(SWCFG))
    except FileNotFoundError:
        j = {"$schema": "/etc/xdg/swaync/configSchema.json"}
    except Exception as e:
        die("swaync config.json is not valid JSON, not touching it: %s" % e)
    backup_once(SWCFG, ".bak-rice-notify")
    j["positionX"] = c["pos_x"]          # popups: left, center or right
    j["positionY"] = c["pos_y"]
    deck = c["layout"] == "deck"
    if deck:
        # the panel has its own side; floating = a gap all around, otherwise flat against the edge, full height
        j["control-center-positionX"] = c["cc_side"]
        j["control-center-positionY"] = "top"
        gap = c["margin"] if c["cc_float"] else 0
        for side in ("top", "bottom", "left", "right"):
            j["control-center-margin-" + side] = gap
        j["fit-to-screen"] = c["fit"] or not c["cc_float"]
    else:
        j.pop("control-center-positionX", None)
        j.pop("control-center-positionY", None)
        for side in ("top", "bottom", "left", "right"):
            j["control-center-margin-" + side] = c["margin"]
        j["fit-to-screen"] = c["fit"]
    j["control-center-width"] = c["panel_width"]
    j["control-center-height"] = c["panel_height"]
    j["notification-window-width"] = c["popup_width"]
    j["timeout"] = c["timeout"]
    j["timeout-low"] = max(2, c["timeout"] // 2)
    j["timeout-critical"] = 0 if c["critical_sticky"] else c["timeout"]
    j["notification-icon-size"] = c["icon_size"]
    j["image-visibility"] = "when-available" if c["images"] else "never"
    light = backlight_device()
    have_pp = shutil.which("powerprofilesctl") is not None
    j["widgets"] = [w for w in ORDER[c["layout"]] if w == "notifications" or c[WKEY[w]]]
    # hide rows this computer cannot use (no screen brightness on a desktop PC, no power-profiles-daemon)
    j["widgets"] = [w for w in j["widgets"] if not (w == "backlight" and not light) and not (w == "buttons-grid#power" and not have_pp)]
    wc = j.setdefault("widget-config", {})
    if deck:
        wc.update(deck_widgets(c, light))
    wc.setdefault("title", {"text": "Notifications", "clear-all-button": True, "button-text": "Clear all"})
    wc.setdefault("dnd", {"text": "Do Not Disturb"})
    wc.setdefault("mpris", {"image-size": 56, "image-radius": 12})
    wc.setdefault("volume", {"label": chr(0xF057E)})
    wc.setdefault("buttons-grid", {"actions": []})
    # sound for new notifications: swaync runs rice-sound, which checks Do Not Disturb itself
    scripts = j.get("scripts") if isinstance(j.get("scripts"), dict) else {}
    scripts.pop("rice-sound", None)
    if c["sound"] != "off":
        scripts["rice-sound"] = {"exec": HOME + "/.local/bin/rice-sound notify", "app-name": ".*", "run-on": "receive"}
    if scripts:
        j["scripts"] = scripts
    else:
        j.pop("scripts", None)
    j["script-fail-notify"] = False
    tmp = SWCFG + ".tmp"
    os.makedirs(SW, exist_ok=True)
    json.dump(j, open(tmp, "w"), indent=2, ensure_ascii=False)
    os.replace(tmp, SWCFG)


def backlight_device():
    try:
        devs = sorted(os.listdir("/sys/class/backlight"))
    except Exception:
        devs = []
    return devs[0] if devs else ""


def deck_widgets(c, light):
    """widget-config of the Deck: three rows of buttons (swaync buttons-grid) and the sliders"""
    def tog(icon, key):
        return {"label": icon, "type": "toggle", "active": False,
                "command": "%s toggle %s" % (SVC, key), "update-command": "%s is %s" % (SVC, key)}

    quick = [tog(chr(0xF05A9), "wifi"), tog(chr(0xF00AF), "bluetooth"), tog(chr(0xF009B), "dnd")]
    if shutil.which("hyprsunset"):
        quick.append(tog(chr(0xF0594), "nightlight"))
    quick.append(tog(chr(0xF0176), "awake"))
    if len(quick) < 5:
        quick.append(tog(chr(0xF036C), "mic"))
    power = [dict(tog(chr(0xF032A) + "  Saver", "profile:power-saver")),
             dict(tog(chr(0xF05D1) + "  Balanced", "profile:balanced")),
             dict(tog(chr(0xF04C5) + "  Performance", "profile:performance"))]
    session = [{"label": chr(0xF033E), "command": SVC + " session lock"},
               {"label": chr(0xF04B2), "command": SVC + " session suspend"},
               {"label": chr(0xF0343), "command": SVC + " session logout"},
               {"label": chr(0xF0709), "command": SVC + " session reboot"},
               {"label": chr(0xF0425), "command": SVC + " session poweroff"}]
    w = {
        "buttons-grid#quick": {"buttons-per-row": len(quick), "actions": quick},
        "buttons-grid#power": {"buttons-per-row": 3, "actions": power},
        "buttons-grid#session": {"buttons-per-row": 5, "actions": session},
        "title": {"text": "Notifications", "clear-all-button": True, "button-text": chr(0xF0A7A) + "  Clear"},
        "volume": {"label": chr(0xF057E), "show-per-app": False},
        "mpris": {"image-size": 52, "image-radius": 12},
    }
    if light:
        w["backlight"] = {"label": chr(0xF00DF), "device": light, "subsystem": "backlight"}
    return w


# ---------------- style.css ----------------
def css(c):
    acc, on_acc = accent() if c["accent"] else ("#F6F5F4", "#0d0d0d")
    base, fg, dim, card0 = palette(c, acc)
    light = c["colors"] == "white"
    op = c["opacity"]
    pop = c["popup_opacity"]
    r = c["radius"]
    ri = max(r - 6, 4)
    pad = 8 if c["compact"] else 12

    def bgc(a):
        return "rgba(%d, %d, %d, %.2f)" % (base[0], base[1], base[2], a)

    edge = "rgba(0, 0, 0, 0.10)" if light else "rgba(255, 255, 255, 0.09)"
    if c["border"] == "accent":
        edge = acc
    elif c["border"] == "none":
        edge = "transparent"
    if c["style"] == "solid":
        bg, card, bd = bgc(1.0), ("rgba(0, 0, 0, 0.06)" if light else "rgba(255, 255, 255, 0.07)"), edge
    elif c["style"] == "outline":
        bg, card, bd = bgc(op), bgc(op), (acc if c["border"] != "none" else "transparent")
    else:
        bg, card, bd = bgc(op), card0, edge
    popup = bgc(1.0 if c["style"] == "solid" else pop)
    shadow = ("0 2px 6px rgba(0, 0, 0, 0.30)" if c["shadow"] else "none")
    v = dict(f=font(c), fs=c["font_size"], acc=acc, onacc=on_acc, bg=bg, card=card, bd=bd, popup=popup, r=r, ri=ri,
             pad=pad, pad2=pad // 2 + 2, fg=fg, dim=dim, shadow=shadow,
             btn=("rgba(0, 0, 0, 0.07)" if light else "rgba(255, 255, 255, 0.08)"),
             fs1=c["font_size"] + 1, fs2=max(9, c["font_size"] - 2),
             hover=("rgba(0, 0, 0, 0.04)" if light else "rgba(255, 255, 255, 0.04)"))
    return """%(begin)s
/* generated by rice-notify (Settings > Notifications). Rules above stay, these win. */
.control-center, .floating-notifications, .blank-window {
  font-family: %(f)s;
  font-size: %(fs)dpx;
}
/* strong selectors: beat a global "* { font-family }" from older themes */
.control-center *, .floating-notifications * {
  font-family: %(f)s;
}
.control-center label, .floating-notifications label {
  font-size: %(fs)dpx;
}
.floating-notifications .notification-row .notification-background .notification .summary,
.control-center .notification-row .notification-background .notification .summary {
  font-size: %(fs1)dpx;
}
.floating-notifications .notification-row .notification-background .notification .time,
.control-center .notification-row .notification-background .notification .time {
  font-size: %(fs2)dpx;
}
/* clean wrappers: only the card itself has a background (no dark frame around popups) */
.floating-notifications .notification-row,
.floating-notifications .notification-row .notification-background,
.floating-notifications .notification-row .notification-background .notification .notification-default-action,
.floating-notifications .notification-row .notification-background .notification .notification-content,
.control-center .notification-row,
.control-center .notification-row .notification-background,
.control-center .notification-row .notification-background .notification .notification-default-action,
.control-center .notification-row .notification-background .notification .notification-content {
  background: transparent;
  box-shadow: none;
  border: none;
  outline: none;
}
.notification-row .notification-background .notification .notification-default-action:hover {
  background: %(hover)s;
}
.blank-window, .floating-notifications {
  background: transparent;
}
.control-center {
  background: %(bg)s;
  border: 1px solid %(bd)s;
  border-radius: %(r)dpx;
  padding: %(pad)dpx;
  color: %(fg)s;
}
.control-center .control-center-list {
  background: transparent;
}
.control-center .control-center-list-placeholder {
  color: %(dim)s;
}
.notification-row {
  outline: none;
  background: transparent;
}
.notification-row .notification-background {
  padding: %(pad2)dpx %(pad)dpx;
  background: transparent;
}
.notification-row .notification-background .notification {
  background: %(card)s;
  border: 1px solid %(bd)s;
  border-radius: %(ri)dpx;
  padding: %(pad)dpx;
  color: %(fg)s;
}
.floating-notifications .notification-row .notification-background .notification {
  background: %(popup)s;
  border-radius: %(r)dpx;
  box-shadow: %(shadow)s;
}
.notification-row .notification-background .notification.critical {
  border: 1px solid rgba(255, 107, 107, 0.7);
}
.notification-row .notification-background .notification .summary {
  font-weight: bold;
  color: %(fg)s;
}
.notification-row .notification-background .notification .body {
  color: %(dim)s;
}
.notification-row .notification-background .notification .time {
  color: %(dim)s;
