}
.widget-dnd > switch:checked {
  background: %(acc)s;
}
.widget-dnd > switch slider {
  border-radius: 100px;
  background: %(fg)s;
}
.widget-mpris {
  margin: %(pad2)dpx %(pad)dpx;
}
.widget-mpris .widget-mpris-player {
  background: %(card)s;
  border: 1px solid %(bd)s;
  border-radius: %(ri)dpx;
  padding: %(pad)dpx;
}
.widget-mpris .widget-mpris-title {
  font-weight: bold;
}
.widget-mpris .widget-mpris-subtitle {
  color: %(dim)s;
}
.widget-buttons-grid {
  margin: %(pad2)dpx %(pad)dpx;
