.widget-buttons-grid > flowbox > flowboxchild > button:hover,
.widget-buttons-grid > flowbox > flowboxchild > button:checked {
  background: %(acc)s;
  color: %(onacc)s;
}
.widget-volume {
  margin: %(pad2)dpx %(pad)dpx;
  padding: %(pad2)dpx %(pad)dpx;
  background: %(card)s;
  border-radius: %(ri)dpx;
}
.widget-volume trough highlight {
  background: %(acc)s;
}
%(popupcss)s
%(deckcss)s
%(end)s
""" % dict(v, begin=BEGIN, end=END, popupcss=popup_css(c, acc, on_acc), deckcss=deck_css(c, v))


def deck_css(c, v):
    """The Deck notification center: rounded tiles, power modes, big soft sliders, power buttons at the bottom."""
    if c["layout"] != "deck":
        return ""
    r = v["r"]
    if c["cc_float"]:
        rad = "%dpx" % r
    else:
        rad = ("%dpx 0 0 %dpx" % (r, r)) if c["cc_side"] == "right" else ("0 %dpx %dpx 0" % (r, r))
    light = c["colors"] == "white"
    tile = "rgba(0, 0, 0, 0.06)" if light else "rgba(255, 255, 255, 0.07)"
    tile_h = "rgba(0, 0, 0, 0.10)" if light else "rgba(255, 255, 255, 0.12)"
    track = "rgba(0, 0, 0, 0.10)" if light else "rgba(255, 255, 255, 0.10)"
    return """/* ---- Deck ---- */
.control-center {
  border-radius: %(rad)s;
  padding: 12px 10px;
}
.control-center .widget-buttons-grid {
  background: transparent;
  padding: 0;
  margin: 3px 6px;
  border-radius: 0;
}
.control-center .widget-buttons-grid > flowbox > flowboxchild {
  padding: 3px;
}
.control-center .widget-buttons-grid > flowbox > flowboxchild > button {
  background: %(tile)s;
  color: %(fg)s;
  border: none;
  box-shadow: none;
  border-radius: 16px;
  min-height: 50px;
  font-size: 1.45em;
  transition: background 160ms ease, color 160ms ease;
}
.control-center .widget-buttons-grid > flowbox > flowboxchild > button:hover {
  background: %(tileh)s;
}
.control-center .widget-buttons-grid > flowbox > flowboxchild > button:checked,
.control-center .widget-buttons-grid > flowbox > flowboxchild > button:checked:hover {
  background: %(acc)s;
  color: #ffffff;  /* switched on: white icon */
}
/* the icon of a switch that is on stays white, whatever older rules say */
.control-center .widget-buttons-grid > flowbox > flowboxchild > button:checked label,
.control-center .widget-buttons-grid > flowbox > flowboxchild > button:checked * {
  color: #ffffff;
}
/* switches: big round-cornered squares */
.control-center .widget-buttons-grid.quick > flowbox > flowboxchild > button {
  min-height: 58px;
  border-radius: 18px;
  font-size: 1.6em;
}
/* power modes: one pill with three parts */
.control-center .widget-buttons-grid.power {
  background: %(tile)s;
  border-radius: 100px;
  padding: 4px;
  margin: 6px 9px;
}
.control-center .widget-buttons-grid.power > flowbox > flowboxchild {
  padding: 0 2px;
}
.control-center .widget-buttons-grid.power > flowbox > flowboxchild > button {
  background: transparent;
  min-height: 36px;
  border-radius: 100px;
  font-size: 1.0em;
  font-weight: bold;
  color: %(dim)s;
}
.control-center .widget-buttons-grid.power > flowbox > flowboxchild > button:hover {
  color: %(fg)s;
  background: transparent;
}
.control-center .widget-buttons-grid.power > flowbox > flowboxchild > button:checked {
  background: %(acc)s;
  color: #ffffff;  /* switched on: white icon */
}
