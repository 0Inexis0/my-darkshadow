#!/usr/bin/env python3
"""rice-rofi: themes and layout for rofi, controlled from Settings > Rofi.

  rice-rofi state            JSON for the settings app
  rice-rofi set KEY VALUE    change one option (theme, layout, position, width, radius,
                             transparency, opacity, blur, icons, font_size, lines)
  rice-rofi apply            regenerate the theme and wire it into rofi / Hyprland
  rice-rofi reset            back to defaults
  rice-rofi restore          put the original rofi/Hyprland files back
"""
import fcntl
import json
import math
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CFG = DIR + "/rofi.json"
FONTS = DIR + "/fonts.json"
ROFI = HOME + "/.config/rofi"
THEME = ROFI + "/shadows.rasi"
ROFI_CFG = ROFI + "/config.rasi"
HYPR = HOME + "/.config/hypr"
LUA = HYPR + "/rice-rofi.lua"
HLUA = HYPR + "/hyprland.lua"
MARK = "/* rice-rofi */"

DEFAULTS = {
    "theme": "shadow", "layout": "list", "position": "center", "width": 620, "radius": 18,
    "transparency": True, "opacity": 0.82, "blur": True, "icons": True, "font_size": 13, "lines": 8,
}
RANGES = {"width": (360, 1200), "radius": (0, 32), "opacity": (0.3, 1.0), "font_size": (9, 20), "lines": (3, 14)}
CHOICES = {"layout": ["list", "grid", "bar"], "position": ["top", "center", "bottom"]}
BOOLS = ("transparency", "blur", "icons")

# bg = window, alt = input/field, sel = selected row, fg = text, dim = secondary text
THEMES = {
    "shadow":   {"name": "Shadow",   "bg": "#0d0d0d", "alt": "#1a1a1a", "fg": "#F6F5F4", "dim": "#8a8a8a", "sel": "#F6F5F4", "selfg": "#0d0d0d", "bd": "#ffffff1a"},
    "graphite": {"name": "Graphite", "bg": "#18181c", "alt": "#24242a", "fg": "#ececf1", "dim": "#8e8e9a", "sel": "#3b3b48", "selfg": "#ffffff", "bd": "#ffffff1a"},
    "midnight": {"name": "Midnight", "bg": "#0b1020", "alt": "#151c33", "fg": "#e6e9f5", "dim": "#7f89ad", "sel": "#8b7bff", "selfg": "#0b1020", "bd": "#8b7bff33"},
    "rose":     {"name": "Rose",     "bg": "#1a1216", "alt": "#271a20", "fg": "#f7e9ee", "dim": "#a98a96", "sel": "#ff8fa3", "selfg": "#2a0f17", "bd": "#ff8fa333"},
    "paper":    {"name": "Paper",    "bg": "#f4f2ee", "alt": "#e6e3dc", "fg": "#1c1c1c", "dim": "#6f6c66", "sel": "#1c1c1c", "selfg": "#f4f2ee", "bd": "#0000001f"},
}


def die(m):
    sys.stderr.write(m + "\n")
    sys.exit(1)


def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def load():
    c = dict(DEFAULTS)
    try:
        raw = json.load(open(CFG))
    except Exception:
        raw = {}
    for k, d in DEFAULTS.items():
        v = raw.get(k, d)
        if k in BOOLS:
            c[k] = v is True
        elif k == "theme":
            c[k] = v if v in THEMES else d
        elif k in CHOICES:
            c[k] = v if v in CHOICES[k] else d
        elif k == "opacity":
            try:
                c[k] = round(clamp(float(v), *RANGES[k]), 2)
            except Exception:
                c[k] = d
        else:
            try:
                c[k] = int(clamp(float(v), *RANGES[k]))
            except Exception:
                c[k] = d
    return c


def save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = CFG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(c, f)
    os.replace(tmp, CFG)


def font_family():
    try:
        f = json.load(open(FONTS))
        return f.get("mono") or f.get("main") or "JetBrainsMono Nerd Font"
    except Exception:
        return "JetBrainsMono Nerd Font"


def rgba(hexcol, a):
    # "#rrggbb" + alpha 0..1  ->  "#rrggbbaa"
    return "%s%02x" % (hexcol[:7], int(round(clamp(a, 0, 1) * 255)))


def theme_text(c):
    t = THEMES[c["theme"]]
    alpha = c["opacity"] if c["transparency"] else 1.0
    bg = rgba(t["bg"], alpha)
    alt = rgba(t["alt"], clamp(alpha + 0.08, 0, 1) if c["transparency"] else 1.0)
    r = c["radius"]
    r_in = max(r - 6, 0)
    w = c["width"]
    layout = c["layout"]
    pos = c["position"]
    if layout == "bar":
        loc = {"top": "north", "center": "center", "bottom": "south"}[pos]
        win = "location: %s;\n    anchor: %s;\n    y-offset: 0px;\n    width: 100%%;\n    border-radius: 0px;" % (loc, loc)
        r = 0
    else:
        if layout == "grid":
            w = max(w, 720)
        if pos == "top":
            win = "location: north;\n    anchor: north;\n    y-offset: 64px;"
        elif pos == "bottom":
            win = "location: south;\n    anchor: south;\n    y-offset: -64px;"
        else:
            win = "location: center;\n    anchor: center;\n    y-offset: 0px;"
        win += "\n    width: %dpx;\n    border-radius: %dpx;" % (w, r)
    fs = c["font_size"]
    fam = font_family().replace('"', "")
    lines = c["lines"]

    if layout == "bar":
        mainbox = ("mainbox {\n    orientation: horizontal;\n    children: [ inputbar, listview ];\n"
                   "    spacing: 14px;\n    padding: 8px 14px;\n    background-color: transparent;\n}")
        inputbar = ("inputbar {\n    children: [ entry ];\n    padding: 6px 12px;\n    border-radius: 10px;\n"
                    "    background-color: @alt;\n    width: 22%;\n}")
        listview = ("listview {\n    layout: horizontal;\n    lines: %d;\n    columns: 1;\n    fixed-height: true;\n"
                    "    scrollbar: false;\n    spacing: 6px;\n    background-color: transparent;\n}" % lines)
        element = ("element {\n    orientation: horizontal;\n    padding: 6px 12px;\n    border-radius: %dpx;\n"
                   "    spacing: 8px;\n    background-color: transparent;\n    text-color: @fg;\n}" % r_in)
        icon = "element-icon {\n    size: 20px;\n    background-color: transparent;\n}"
        text = "element-text {\n    background-color: transparent;\n    text-color: inherit;\n    vertical-align: 0.5;\n}"
    elif layout == "grid":
        mainbox = ("mainbox {\n    children: [ inputbar, listview ];\n    spacing: 14px;\n    padding: 16px;\n"
                   "    background-color: transparent;\n}")
        inputbar = ("inputbar {\n    children: [ entry ];\n    padding: 10px 16px;\n    border-radius: %dpx;\n"
                    "    background-color: @alt;\n}" % r_in)
        listview = ("listview {\n    columns: 4;\n    lines: %d;\n    fixed-height: false;\n    scrollbar: false;\n"
                    "    spacing: 8px;\n    background-color: transparent;\n}" % max(2, int(math.ceil(lines / 3.0))))
        element = ("element {\n    orientation: vertical;\n    padding: 14px 8px;\n    border-radius: %dpx;\n"
                   "    spacing: 8px;\n    background-color: transparent;\n    text-color: @fg;\n}" % r_in)
        icon = "element-icon {\n    size: 56px;\n    background-color: transparent;\n    horizontal-align: 0.5;\n}"
        text = ("element-text {\n    background-color: transparent;\n    text-color: inherit;\n"
                "    horizontal-align: 0.5;\n    vertical-align: 0.5;\n}")
    else:
        mainbox = ("mainbox {\n    children: [ inputbar, listview ];\n    spacing: 10px;\n    padding: 14px;\n"
                   "    background-color: transparent;\n}")
        inputbar = ("inputbar {\n    children: [ entry ];\n    padding: 10px 16px;\n    border-radius: %dpx;\n"
                    "    background-color: @alt;\n}" % r_in)
        listview = ("listview {\n    columns: 1;\n    lines: %d;\n    fixed-height: false;\n    scrollbar: false;\n"
                    "    spacing: 4px;\n    background-color: transparent;\n}" % lines)
        element = ("element {\n    orientation: horizontal;\n    padding: 8px 12px;\n    border-radius: %dpx;\n"
                   "    spacing: 12px;\n    background-color: transparent;\n    text-color: @fg;\n}" % r_in)
        icon = "element-icon {\n    size: 28px;\n    background-color: transparent;\n}"
        text = "element-text {\n    background-color: transparent;\n    text-color: inherit;\n    vertical-align: 0.5;\n}"

    return """/* Shadow's Shell rofi theme. Generated by rice-rofi, edit it in Settings > Rofi. */
configuration {
    show-icons: %(icons)s;
    drun-display-format: "{name}";
}

* {
    bg: %(bg)s;
    alt: %(alt)s;
    fg: %(fg)s;
    dim: %(dim)s;
    sel: %(sel)s;
    selfg: %(selfg)s;
    bd: %(bd)s;
    font: "%(fam)s %(fs)d";
}

window {
    %(win)s
    background-color: @bg;
    border: 1px;
    border-color: @bd;
    padding: 0px;
}

%(mainbox)s

%(inputbar)s

entry {
    placeholder: "Search";
    placeholder-color: @dim;
    text-color: @fg;
    background-color: transparent;
    cursor-color: @fg;
}

prompt {
    enabled: false;
}

%(listview)s

%(element)s

element normal.normal, element alternate.normal, element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @fg;
}

element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: #ff6b6b;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @sel;
    text-color: @selfg;
}

%(icon)s

%(text)s

scrollbar {
    enabled: false;
}

message {
    background-color: transparent;
    padding: 4px 8px;
}

textbox {
    text-color: @fg;
    background-color: transparent;
}
""" % {
        "icons": "true" if c["icons"] else "false", "bg": bg, "alt": alt, "fg": t["fg"], "dim": t["dim"],
        "sel": t["sel"], "selfg": t["selfg"], "bd": t["bd"], "fam": fam, "fs": fs, "win": win,
        "mainbox": mainbox, "inputbar": inputbar, "listview": listview, "element": element,
        "icon": icon, "text": text,
    }


def lua_text(c):
    out = ["-- generated by rice-rofi (Settings > Rofi). Do not edit by hand.\n"]
    if c["blur"]:
        out.append('hl.layer_rule({\n    name  = "rice-rofi-blur",\n    match = { namespace = "rofi" },\n'
                   '    blur = true,\n    ignore_alpha = 0.1,\n})\n')
    return "".join(out)


def backup_once(path, suffix):
    b = path + suffix
    if os.path.exists(path) and not os.path.exists(b):
        shutil.copy2(path, b)


def wire_rofi():
    os.makedirs(ROFI, exist_ok=True)
    inc = '%s @theme "%s"\n' % (MARK, THEME)
    s = open(ROFI_CFG).read() if os.path.exists(ROFI_CFG) else ""
    backup_once(ROFI_CFG, ".bak-rice-rofi")
    lines = []
    for ln in s.splitlines():
        if re.match(r'\s*@theme\s+"', ln) and "rice-rofi" not in ln and MARK not in ln:
            ln = "// rice-rofi disabled: " + ln
        if MARK in ln:
            continue
        lines.append(ln)
    new = "\n".join(lines).rstrip("\n") + ("\n" if lines else "") + inc
    if new != s:
        open(ROFI_CFG, "w").write(new)


def wire_hypr():
    """Remove the old static rofi blur rule (we control it now) and require rice-rofi. Returns True if changed."""
    if not os.path.exists(HLUA):
        return False
    s = open(HLUA).read()
    n = s
    n = re.sub(r'hl\.layer_rule\(\{\s*name\s*=\s*"rofi-blur",.*?\}\)\n?\n?', "", n, flags=re.S)
    if 'require("rice-rofi")' not in n:
        a = 'require("rice-settings")'
        if n.count(a) == 1:
            n = n.replace(a, a + '\nrequire("rice-rofi")')
        else:
            n = n.rstrip("\n") + '\n\nrequire("rice-rofi")\n'
    if n != s:
        backup_once(HLUA, ".bak-rofi")
        open(HLUA, "w").write(n)
        return True
    return False


def apply(c, reload_hypr=False):
    os.makedirs(ROFI, exist_ok=True)
    open(THEME, "w").write(theme_text(c))
    wire_rofi()
    old = open(LUA).read() if os.path.exists(LUA) else None
    new = lua_text(c)
    changed = (old != new)
    if changed:
        open(LUA, "w").write(new)
    if wire_hypr():
        changed = True
    if (changed or reload_hypr) and shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def state():
    c = load()
    out = dict(c)
    out["themes"] = {k: {"name": v["name"], "bg": v["bg"], "alt": v["alt"], "sel": v["sel"], "fg": v["fg"]}
                     for k, v in THEMES.items()}
    out["installed"] = shutil.which("rofi") is not None
    print(json.dumps(out))


def setkey(k, v):
    if k not in DEFAULTS:
        die("unknown key: " + k)
    c = load()
    if k in BOOLS:
        c[k] = str(v).lower() in ("1", "true", "on", "yes")
    elif k == "theme":
        if v not in THEMES:
            die("theme: " + "|".join(THEMES))
        c[k] = v
    elif k in CHOICES:
        if v not in CHOICES[k]:
            die("%s: %s" % (k, "|".join(CHOICES[k])))
        c[k] = v
    elif k == "opacity":
        c[k] = round(clamp(float(v), *RANGES[k]), 2)
    else:
        c[k] = int(clamp(float(v), *RANGES[k]))
    save(c)
    apply(c)


def restore():
    for path, suf in ((ROFI_CFG, ".bak-rice-rofi"), (HLUA, ".bak-rofi")):
        if os.path.exists(path + suf):
            shutil.copy2(path + suf, path)
            print("restored", path)
    for p in (THEME, LUA):
        if os.path.exists(p):
            os.remove(p)
    if shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main(argv):
    if len(argv) < 2:
        die(__doc__)
    cmd = argv[1]
    if cmd == "state":
        state()
        return
    os.makedirs(DIR, exist_ok=True)
    lk = open(DIR + "/.rofi.lock", "w")
    fcntl.flock(lk, fcntl.LOCK_EX)
    if cmd == "apply":
        c = load()
        save(c)
        apply(c, reload_hypr=True)
    elif cmd == "set":
        if len(argv) < 4:
            die("usage: rice-rofi set KEY VALUE")
        setkey(argv[2], argv[3])
    elif cmd == "reset":
        if os.path.exists(CFG):
            os.remove(CFG)
        apply(load())
    elif cmd == "restore":
        restore()
    else:
        die(__doc__)


if __name__ == "__main__":
    main(sys.argv)
