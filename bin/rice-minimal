#!/usr/bin/env python3
"""rice-minimal: Minimal mode (Settings > Look & Feel > Minimal mode).

Square corners everywhere (windows, the bar, the dock, panels, menus, widgets, Settings, Files, Music, the lock
screen), window frames like a classic floating window manager, a flat bar and a terminal with room to breathe.

  rice-minimal state                  JSON: {on, frame, width, solid, bar}
  rice-minimal on|off|toggle
  rice-minimal set KEY VALUE          frame double|single|thin   (double: a frame in your theme color with a dark
                                                                  line outside it; single: the color frame only;
                                                                  thin: one quiet line)
                                      width 1-8                  (how thick the color frame of the windows is)
                                      solid on|off               (windows without transparency and blur; off
                                                                  by default)
                                      bar on|off                 (the bar turns flat, with numbered workspaces,
                                                                  while Minimal mode is on; your bar comes back
                                                                  when it is off)
  rice-minimal apply                  write everything again (the installer runs this)

Undo: rice-minimal off.
"""
import json
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
CFG = DIR + "/minimal.json"
HYPR = HOME + "/.config/hypr"
LUA = HYPR + "/rice-minimal.lua"
GAMING = HYPR + "/rice-gaming.lua"
REQ = 'pcall(require, "rice-minimal")'
KITTY = HOME + "/.config/kitty"
KCONF = KITTY + "/rice-minimal.conf"
KLINE = "globinclude rice-minimal.conf"
KMARK = "# DarkShadow's Shell: Minimal mode (Settings > Look & Feel)"
BIN = HOME + "/.local/bin"

DEFAULTS = {"on": False, "frame": "double", "width": 3, "solid": False, "bar": True}
FRAMES = ("double", "single", "thin")


def load():
    c = dict(DEFAULTS)
    try:
        raw = json.load(open(CFG))
        for k in DEFAULTS:
            if k in raw:
                c[k] = raw[k]
        for k in ("prev_style", "prev_ws"):
            if k in raw:
                c[k] = raw[k]
        # V5.00: "Solid windows" is off by default (it turned the blur off, so Hyprland's blur settings seemed broken);
        # a file from V4.98-V4.99 had it on without anyone choosing it
        if raw.get("v", 1) < 2:
            c["migrated"] = raw.get("on") is True and raw.get("solid", True) is not False
            c["solid"] = False
    except Exception:
        pass
    if c["frame"] not in FRAMES:
        c["frame"] = "double"
    try:
        c["width"] = int(max(1, min(8, int(c["width"]))))
    except Exception:
        c["width"] = 3
    for k in ("on", "solid", "bar"):
        c[k] = c[k] is True
    return c


def save(c):
    os.makedirs(DIR, exist_ok=True)
    # written in place (not a new file put over it): the shell, Settings and the apps watch this file, and a
    # watch stays on the file only while it is the same file
    c["v"] = 2
    t = json.dumps({k: v for k, v in c.items() if k != "migrated"})
    try:
        if open(CFG).read() == t:
            return
    except Exception:
        pass
    with open(CFG, "w") as f:
        f.write(t)


def q(cmd, timeout=10):
    if not shutil.which(cmd[0]) and not os.path.exists(cmd[0]):
        return ""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def border_color():
    """the first wallpaper border color (border-sync), or your own (Settings > Hyprland > Borders)"""
    try:
        s = json.load(open(DIR + "/hypr.json"))
        b = s.get("borders", {})
        if os.path.exists(DIR + "/border-custom") and b.get("active"):
            return b["active"].lstrip("#")[:6]
    except Exception:
        pass
    try:
        c = open(HYPR + "/border-colors.txt").read().split()[0].lstrip("#")[:6]
        if len(c) == 6:
            return c
    except Exception:
        pass
    return "c8bfae"


# ---------------- Hyprland ----------------
def lua_text(c):
    if not c["on"]:
        return "-- generated by rice-minimal (Settings > Look & Feel > Minimal mode): off\n"
    w = c["width"]
    col = border_color()
    out = ["-- generated by rice-minimal (Settings > Look & Feel > Minimal mode)\n",
           "pcall(hl.config, { decoration = { rounding = 0 } })\n"]
    if c["frame"] == "thin":
        out.append('pcall(hl.config, { general = { border_size = 1, col = { active_border = "rgba(%sb0)", '
                   'inactive_border = "rgba(3a3a3aff)" } } })\n' % col)
        out.append("pcall(hl.config, { decoration = { shadow = { enabled = false } } })\n")
    else:
        out.append('pcall(hl.config, { general = { border_size = %d, col = { active_border = "rgba(%sff)", '
                   'inactive_border = "rgba(2e2e2eff)" } } })\n' % (w, col))
        if c["frame"] == "double":
            # the dark line outside the frame: a hard shadow without blur or offset
            out.append("pcall(hl.config, { decoration = { shadow = { enabled = true, range = 2, render_power = 1, "
                       "color = 0xff0b0b0b } } })\n")
            out.append("pcall(hl.config, { decoration = { shadow = { sharp = true } } })\n")
            out.append("pcall(hl.config, { decoration = { shadow = { color_inactive = 0xff0b0b0b } } })\n")
        else:
            out.append("pcall(hl.config, { decoration = { shadow = { enabled = false } } })\n")
    if c["solid"]:
        out.append("pcall(hl.config, { decoration = { blur = { enabled = false }, active_opacity = 1.0, inactive_opacity = 1.0 } })\n")
        out.append('pcall(hl.window_rule, { name = "rice-minimal-solid", match = { class = ".*" }, opacity = "1.0 override 1.0 override" })\n')
    return "".join(out)


def wire_hypr():
    """rice-gaming.lua is loaded last (rice-effects); it loads this file first, so gaming mode still wins"""
    try:
        s = open(GAMING).read()
    except FileNotFoundError:
        s = None
    if s is not None and REQ not in s:
        lines = s.split("\n", 1)
        n = lines[0] + "\n" + REQ + "\n" + (lines[1] if len(lines) > 1 else "")
        open(GAMING, "w").write(n)
    if s is None:
        # no rice-effects yet: ask it to write its file (it loads this one)
        q([BIN + "/rice-effects", "apply"], timeout=60)


# ---------------- kitty ----------------
def kitty(c):
    if not os.path.isdir(KITTY):
        return
    body = "# generated by rice-minimal (Settings > Look & Feel > Minimal mode)\n"
    if c["on"]:
        body += ("window_padding_width 12\n"
                 "cursor_shape block\n"
                 "cursor_blink_interval 0\n"
                 "cursor_trail 0\n"
                 "tab_bar_style separator\n"
                 "tab_separator \" | \"\n")
        if c["solid"]:
            body += "background_opacity 1.0\n"
    old = open(KCONF).read() if os.path.exists(KCONF) else None
    if body != old:
        open(KCONF, "w").write(body)
    conf = KITTY + "/kitty.conf"
    try:
        s = open(conf).read()
    except FileNotFoundError:
        s = ""
    if KLINE not in s:
        # before rice-effects' own lines, so "no transparency" there still has the last word
        lines = s.rstrip("\n").split("\n") if s.strip() else []
        at = len(lines)
        for i, l in enumerate(lines):
            if l.strip().startswith("# DarkShadow's Shell: blur & transparency switch"):
                at = i
                break
        lines[at:at] = [KMARK, KLINE, ""]
        open(conf, "w").write("\n".join(lines).rstrip("\n") + "\n")
    for name in ("kitty", ".kitty-wrapped"):
        q(["pkill", "-USR1", "-x", name], timeout=3)


# ---------------- the bar ----------------
def bar(c, had):
    """the flat bar comes when Minimal mode (with Flat bar) turns on, and your own bar comes back when it turns off.
    Only when it turns on or off: a bar style you choose while it is on stays (V5.00; an update made it flat again)"""
    want = c["on"] and c["bar"]
    if want == had:
        return
    rb = BIN + "/rice-bar"
    if not os.access(rb, os.X_OK):
        return
    try:
        st = json.loads(q([rb, "state"]) or "{}")
    except ValueError:
        st = {}
    if want:
        c["prev_style"] = st.get("style", "dynamic")
        c["prev_ws"] = st.get("ws_style", "dots")
        q([rb, "set", "style", "flat"])
        q([rb, "set", "ws_style", "numbers"])
    elif "prev_style" in c:
        if st.get("style") == "flat":
            q([rb, "set", "style", c["prev_style"]])
        if st.get("ws_style") == "numbers":
            q([rb, "set", "ws_style", c.get("prev_ws", "dots")])
        c.pop("prev_style", None)
        c.pop("prev_ws", None)


def apply(c, had_bar=None, reload_wm=True):
    if had_bar is None:
        had_bar = c["on"] and c["bar"]
    bar(c, had_bar)
    save(c)
    os.makedirs(HYPR, exist_ok=True)
    old = open(LUA).read() if os.path.exists(LUA) else ""
    new = lua_text(c)
    changed = new != old
    if changed:
        open(LUA, "w").write(new)
    wire_hypr()
    kitty(c)
    # the one-time change of V5.00 (Solid windows off) brings the blur back now, even from the installer
    if c.get("migrated") and changed:
        reload_wm = True
    if reload_wm:
        if q([BIN + "/rice-wm"]).strip() == "niri":
            q([BIN + "/rice-niri", "apply"], timeout=30)
        elif changed:
            q([BIN + "/rice-wm", "reload"], timeout=20)
            # the wallpaper colors of the frame (border-sync sets them again after a reload)
            q([BIN + "/border-sync"], timeout=10)


def main(a):
    cmd = a[0] if a else "state"
    c = load()
    if cmd == "state":
        print(json.dumps({k: c[k] for k in DEFAULTS}))
    elif cmd in ("on", "off", "toggle"):
        had = c["on"] and c["bar"]
        c["on"] = (not c["on"]) if cmd == "toggle" else cmd == "on"
        apply(c, had)
    elif cmd == "set" and len(a) == 3:
        had = c["on"] and c["bar"]
        k, v = a[1], a[2]
        if k == "frame":
            if v not in FRAMES:
                sys.exit("frame: " + "|".join(FRAMES))
            c[k] = v
        elif k == "width":
            try:
                c[k] = int(max(1, min(8, int(float(v)))))
            except ValueError:
                sys.exit("width: 1-8")
        elif k in ("solid", "bar"):
            c[k] = v.lower() in ("1", "true", "on", "yes")
        else:
            sys.exit(__doc__)
        apply(c, had)
    elif cmd == "apply":
        apply(c, None, reload_wm="--no-reload" not in a)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
