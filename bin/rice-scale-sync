#!/usr/bin/env python3
"""Publish the shell's main display scale to XWayland via XSettings/Xresources.

Native Wayland apps use their compositor-provided per-output scale. X11 has
one desktop DPI value, so use the screen selected as main in rice-screens.
"""
import fcntl
import json
import math
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time

HOME = Path.home()
CONFIG = HOME / '.config/rice/xsettingsd.conf'
XSETTINGSD = Path(shutil.which('xsettingsd') or HOME / '.local/share/rice-xsettingsd/bin/xsettingsd')


def display_scale(monitors, main=''):
    active = [m for m in monitors if not m.get('disabled')]
    if not active:
        raise ValueError('No active displays')
    active.sort(key=lambda m: (m.get('x', 0), m.get('y', 0), m['name']))
    monitor = next((m for m in active if m['name'] == main), active[0])
    scale = float(monitor.get('scale', 1))
    if not math.isfinite(scale) or not 0.25 <= scale <= 10:
        raise ValueError('Invalid display scale')
    return scale


def current_scale():
    result = subprocess.run(['hyprctl', 'monitors', '-j'], check=True,
                            capture_output=True, text=True, timeout=5)
    try:
        main = json.loads((HOME / '.config/rice/screens.json').read_text()).get('main', '')
    except (OSError, ValueError):
        main = ''
    return display_scale(json.loads(result.stdout), main)


def publish(scale):
    dpi = 96 * scale
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    temp = CONFIG.with_suffix('.tmp')
    temp.write_text('# Generated by rice-scale-sync from the shell display scale.\n'
                    f'Xft/DPI {round(dpi * 1024)}\n')
    temp.replace(CONFIG)
    subprocess.run(['xrdb', '-merge'], input=f'Xft.dpi: {dpi:g}\n',
                   text=True, check=True, capture_output=True, timeout=5)
    return dpi


def watch():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/tmp/rice-scale-{os.getuid()}'))
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock = (runtime / 'rice-scale-sync.lock').open('w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    child = None
    previous = None
    stopping = False

    def stop(*_):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        while not stopping:
            try:
                scale = current_scale()
                running = child is not None and child.poll() is None
                if scale != previous or not running:
                    dpi = publish(scale)
                    if running:
                        child.send_signal(signal.SIGHUP)
                    else:
                        child = subprocess.Popen([str(XSETTINGSD), '-c', str(CONFIG)])
                    previous = scale
                    print(f'Shell scale {scale:g}: XWayland DPI {dpi:g}', flush=True)
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                print(f'rice-scale-sync: {error}', file=sys.stderr, flush=True)
            time.sleep(2)
    finally:
        if child is not None and child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=3)
            except subprocess.TimeoutExpired:
                child.kill()


if __name__ == '__main__':
    if sys.argv[1:] == ['--once']:
        scale = current_scale()
        print(json.dumps({'scale': scale, 'dpi': publish(scale)}))
    else:
        watch()
